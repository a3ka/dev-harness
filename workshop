#!/usr/bin/env bash
# Вход в систему-разработчика.
#
#   ./workshop                      работа НАД инструментом
#   ./workshop <проект>              работа с проектом (или разговор — режим держит политика подтверждений)
#   ./workshop --plan <файл>         указание предмета работы (опционально, НЕ ключ замка)
#   ./workshop -r/--resume <id>      продолжение сохранённой сессии (по прямому слову владельца, 30acda0)
#   ./workshop --check-metering      проверка прокси учёта: healthz, при необходимости — подъём
#                                    [--config <файл>] (умолчание config/metering.json)
#
# Режим входа — политика подтверждений, а не инвентарь (контракт 002, критерий 1).
# Прежняя конструкция делила входы на `--talk` (чтение) и `--work` (полный
# инвентарь), и обещание «в разговоре править нельзя» держалось ОТСУТСТВИЕМ
# инструментов. Измеренный дефект: переключение режима требовало перезапуска
# сессии, а слово владельца «работай» терялось вместе с контекстом.
#
# `always-ask` в `.omp/config.yml` (контракт 002) переносит режим в политику
# omp: каждый инструмент спрашивает разрешения, и инвентарь один на сессию.
#
# `--plan` остаётся ОПЦИОНАЛЬНЫМ указанием предмета работы, а не ключом замка.
# Сессия работы стартует со СВЕЖИМ контекстом от НАПИСАННОГО плана, а не от
# переписки. Исполнитель не может «помнить, о чём договорились» — он обязан
# прочитать, что записано. Но план нужен как предмет, а не как пропуск в сессию.
#
# `-r/--resume` СОХРАНЯЕТСЯ: продолжение сессии. Разрешение владельца записано в
# истории (коммит 30acda0: «добавить флаг -r/--resume по прямому слову владельца»).
#
# `--check-metering` — отдельный режим, не вход в сессию. Запускается ПЕРЕД
# сессией: проверяет, жив ли прокси учёта; мёртв — поднимает ФОНОМ и ждёт
# healthz; ребёнок умер / молчит за окно / порт занят чужим — отказ с НАЗВАННОЙ
# причиной. Контракт 005 §6, критерий 4. Проверяется `check_metering.sh --cold-start`.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die()  { printf 'ОТКАЗ: %s\n' "$*" >&2; exit 1; }
skip() { printf 'NOT_IMPLEMENTED: %s\n' "$*" >&2; exit 2; }

# ── сессионный HOME НАРУЖУ корня чекаута (контракт 028, Н-98) ───────────────────
# Дерево чекаута — СУДИМОЕ: `check_no_leak.sh` ловит любое изменение под ним, и
# каналы записи (`.zones/<h>/cache/composer/<hash>/status.json`, `.omp/agent.db`,
# `.npm/_logs/*.log` и пр.) уходят в `find -newermt` сверки. Перенос сессионного
# `HOME` наружу чекаута закрывает топологию: путь рантайма теперь идёт мимо
# стерегомого дерева, и `find` сверки его не видит вовсе.
#
# ДОМ — ВНЕШНИЙ и ДОЛГОВЕЧНЫЙ. Единственная ручка — `HARNESS_SCRATCH` (явная);
# иначе — `XDG_STATE_HOME` (явный И дефолтный `$HOME/.local/state`); иначе
# дефолт-формула `<state>/dev-harness-sessions/<hash8-канон-корня>/zones/dev`.
# Стоит на прочной ФС: `/tmp` — tmpfs, и 2,6 ГБ судебных улик не пережили бы
# ребут. Никаких `${TMPDIR:-/tmp}`-затравок (отдельный предмет, 026:171-185).
#
# КАНОН-КОРЕНЬ ЧЕКАУТА — спуск до существующего предка + `pwd -P` (мера 014);
# лексические алиасы одного пути дают ОДИН `hash8` (прецедент `lib_zones.sh:69`).
# Канонический РЕЗУЛЬТАТ разрешения ZONE (симлинки в любом звене пути
# разрешаются канонизацией) обязан лежать ВНЕ канон-корня — ДЛЯ ЛЮБОГО
# источника. Разрешившийся внутрь — die ДО создания каталогов, подмены HOME и
# exec; в блоке ZONE, раньше разбора входов (дешёвая проверка на дешёвом этапе).
#
# ПЕРЕДАЧА разрешённого корня потребителю (инвариант 1, совет 2 v1): без
# экспорта `HARNESS_SESSION_HOME="$ZONE"` потомок `models_actual.sh`,
# унаследовавший уже подменённый `$HOME`, повторной формулой от `$HOME` уходит
# в ДРУГОЙ корень — «побайтово тот же блок» не спасает от другой среды
# вычисления. Экспорт — здесь, до `export HOME` ниже (:437/:502).
_028_ROOT_TAIL=""
_028_ROOT="$HERE"
while [ ! -d "$_028_ROOT" ] && [ "$_028_ROOT" != "/" ]; do
  _028_ROOT_TAIL="/${_028_ROOT##*/}$_028_ROOT_TAIL"
  _028_ROOT="${_028_ROOT%/*}"
done
if [ -d "$_028_ROOT" ]; then
  _028_CANON="$(cd "$_028_ROOT" && pwd -P)$_028_ROOT_TAIL"
else
  _028_CANON="$(cd "$HERE" && pwd -P)"
fi
_028_HASH8="$(printf '%s' "$_028_CANON" | sha256sum | cut -c1-8)"
if [ -n "${HARNESS_SESSION_HOME:-}" ]; then
  _028_T="$HARNESS_SESSION_HOME"
elif [ -n "${HARNESS_SCRATCH:-}" ]; then
  _028_T="$HARNESS_SCRATCH/zones/dev"
else
  _028_T="${XDG_STATE_HOME:-$HOME/.local/state}/dev-harness-sessions/$_028_HASH8/zones/dev"
fi
_028_RES_TAIL=""
_028_RES="$_028_T"
while [ ! -e "$_028_RES" ] && [ "$_028_RES" != "/" ]; do
  _028_RES_TAIL="/${_028_RES##*/}$_028_RES_TAIL"
  _028_RES="${_028_RES%/*}"
done
if [ -e "$_028_RES" ] && [ "$_028_RES" != "/" ]; then
  _028_CANON_RESOLVED="$(cd "$_028_RES" && pwd -P)$_028_RES_TAIL"
else
  _028_CANON_RESOLVED="$_028_T"
fi
case "${_028_CANON_RESOLVED}/" in
  "${_028_CANON}/"*)
    die "канонический результат разрешения ZONE внутри стерегомого дерева: $_028_CANON_RESOLVED" ;;
esac
ZONE="$_028_T"
export HARNESS_SESSION_HOME="$ZONE"
PROFILE="dev"


# ── окружение и учёт: ОДНА реализация на оба входа ───────────────────────────
# Две копии этой логики разошлись бы молча. Проверено на себе: проверка прокси стояла
# только в ветке проекта, и вход в сам инструмент после перевода живой сессии на провайдера
# с ключом переставал работать — вызовы падали бы на первом обращении.

# Уже заданное НЕ затирается. У фабрики измерен ровно этот дефект: обёртки грузили `.env`
# через `set -a`, поэтому `ПЕРЕМЕННАЯ=значение npm run ...` молча не действовала для всего,
# что объявлено в `.env`, и поведение объясняли чем угодно, кроме настоящей причины.
load_env() {
  [ -f "$1/.env" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in ''|'#'*) continue ;; esac
    k="${k%% *}"
    [ -n "${!k:-}" ] || export "$k=$(printf '%s' "$v" | sed 's/^["'"'"']//;s/["'"'"']$//')"
  done < "$1/.env"
}

# ВТОРОЙ ДОМ СЕКРЕТОВ — ~/.config/dev-harness/secrets.env, ВНЕ репозитория. Механика
# измерена 2026-08-19: харнесовский .env (в .gitignore) умирает при ресетах/переклонах;
# дом секретов вне дерева переживает оба. Решение владельца 2026-08-19: харнес НЕ зависит
# от фабрики контента — фабрика лишь будущий проект; раньше вторым домом служил её .env,
# зависимость развязана. Недостающие из разрешённого списка подтягиваются и дописываются
# в наш .env: реставрация после ресета — просто запуск воркшопа. Значения не печатаются.
SECRETS_HOME="${HOME}/.config/dev-harness/secrets.env"
bootstrap_env() {
  [ -f "$SECRETS_HOME" ] || return 0
  local k v wrote=0
  while IFS='=' read -r k v; do
    case "$k" in ZAI_API_KEY|MINIMAX_API_KEY|METERING_PROXY_URL|METERING_PROXY_TOKEN) ;; *) continue ;; esac
    [ -n "${!k:-}" ] && continue
    [ -n "$v" ] || continue
    export "$k=$(printf '%s' "$v" | sed 's/^["'"'"']//;s/["'"'"']$//')"
    grep -q "^$k=" "$HERE/.env" 2>/dev/null || { printf '%s=%s\n' "$k" "$v" >> "$HERE/.env"; wrote=1; }
  done < "$SECRETS_HOME"
  [ "$wrote" -eq 0 ] || printf '  ok   .env дописан из дома секретов (~/.config/dev-harness)\n' >&2
}


# Живая сессия работает на роли `default`. Стоит она на провайдере с ключом — вызовы идут
# через прокси учёта, и без адреса сессия не заработает вовсе. Отказ при запуске дешевле
# отказа на середине работы: там уже потрачено время, а причина выглядит как ошибка модели.
# Сессия ВЕДЁТСЯ РОЛЬЮ `orchestrator`, а не безымянным участником. Решение владельца 2026-08-16:
# у живой сессии не было файла роли — единственный участник без объявленного инвентаря и без
# записанных обязанностей. Роль и есть сессия. Топология — решения владельца 2026-08-24
# (дешёвый оркестратор) и 2026-09-12 (glm); модели назначает ТОЛЬКО
# config/agent_models.json (единый источник), здесь имён моделей нет.
SESSION_ROLE="orchestrator"

# Модель сессии — модель ЭТОЙ роли, а не `default`. Читается из порождённого агента и конфига,
# то есть из тех же артефактов, что и у остальных: второго источника нет.
session_model() {
  local mr
  mr="$(grep -oE '^model: \["@[a-z]+"\]' "$HERE/.omp/agents/$SESSION_ROLE.md" 2>/dev/null | sed 's/.*@//;s/"\]//')"
  [ -n "$mr" ] || die "у роли $SESSION_ROLE не объявлена роль модели — порождение сломано"
  local cfg="${MODELS:-$HERE/.omp/config.yml}" m
  m="$(grep -oE "^\\s+${mr}:\\s*\"[^\"]+\"" "$cfg" 2>/dev/null | sed 's/.*"\(.*\)"/\1/' || true)"
  [ -n "$m" ] || m="$(grep -oE "^\\s+${mr}:\\s*\"[^\"]+\"" "$HERE/.omp/config.yml" | sed 's/.*"\(.*\)"/\1/')"
  [ -n "$m" ] || die "роль модели @$mr не объявлена ни в оверлее, ни в .omp/config.yml"
  LIVE_MODEL="$m"
}

# Учёт требуется, если провайдер с ключом назначен ЛЮБОЙ роли, а не только сессии. Прежняя
# редакция смотрела на сессию: с переводом сессии на Anthropic проверка перестала бы срабатывать,
# хотя implementer остался на MiniMax и его расход по-прежнему обязан считаться.
require_metering() {
  session_model
  # Ключ провайдера ЖИВОЙ СЕССИИ проверяется ПРИ ЗАПУСКЕ, а не на первом вызове. Сессия идёт
  # на модели тира `default` (config/agent_models.json; zai/glm), и этот трафик НЕ идёт
  # через прокси учёта (у z.ai подписка, а не ключ с
  # потолком) — значит проверка minimax ниже его не ловила, и пустой ZAI_API_KEY всплывал
  # только как «No API key found for zai» на середине работы, причиной, похожей на ошибку
  # модели. Отказ при запуске дешевле отказа на середине — то же правило, что и для minimax.
  # После хард-ресета машины ключ из .env пропадает (файл в .gitignore, не переживает откат
  # ФС при потере питания), и без этого гейта сессия молча стартовала бы в никуда.
  case "$LIVE_MODEL" in
    zai/*) [ -n "${ZAI_API_KEY:-}" ] || die "модель сессии $LIVE_MODEL, а ZAI_API_KEY пуст даже после автосборки: проверь строку в ~/.config/dev-harness/secrets.env (дом секретов, вне репозитория)" ;;
  esac
  local keyed
  keyed="$(grep -ohE '"minimax/[^"]+"' "$HERE/.omp/config.yml" "${MODELS:-/dev/null}" 2>/dev/null | head -1 || true)"
  [ -n "$keyed" ] || return 0
  [ -n "${METERING_PROXY_URL:-}" ] || die "провайдер с ключом назначен ($keyed), а METERING_PROXY_URL не задана. Прокси поднимает проект: подними его и объяви адрес в $1/.env"
  [ -n "${METERING_PROXY_TOKEN:-}" ] || die "METERING_PROXY_TOKEN пуст: прокси учёта отвергнет вызов. Значение то же, что у проекта, поднимающего прокси — перенеси его в $1/.env"
  [ -n "${MINIMAX_API_KEY:-}" ] || die "MINIMAX_API_KEY пуст: omp не работает с провайдером без его ключа, и поля apiKey в models.yml для этого недостаточно — измерено. Перенеси ключ в $1/.env"
}

# ── режим --check-metering: проверка/подъём прокси учёта (контракт 005 §6) ─────
# Прежняя проверка стояла на адресе из `METERING_PROXY_URL` — адрес есть, ответа нет, и
# сессия поднималась в никуда. Теперь лаунчер проверяет сам ПРОКСИ по конфигу:
#   1) читает port и healthz_window_sec из конфига (НЕ зашитые 8765/5 — барьер ветви (4)
#      красит зашитые как дефект);
#   2) пробует GET /healthz на этом порту; ответил 200 — выход 0;
#   3) не ответил — поднимает ребёнка `node scripts/proxy/metering_proxy.ts --config <ф>`,
#      pid в `~/.config/dev-harness/proxy.pid`, ждёт healthz_window_sec секунд;
#   4) ребёнок умер в окне — отказ НЕМЕДЛЕННО с названным кодом выхода;
#   5) окно истекло, ребёнок жив, healthz молчит — отказ по окну;
#   6) на порту чужой слушатель (ответил НЕ 200) — отказ, ребёнка не поднимаем.
#
# Недоступный upstream НЕ повод гибнуть: прокси с мёртвым upstream поднимается и здоров,
# отказ upstream — пер-запросный (502 со строкой журнала, ветвь (д)).
#
# ПРИЧИНЫ ОТКАЗА — фиксированные строки, чтобы фикстуры `check_metering.sh --cold-start`
# грепали стабильно. Печатаются ОДНОЙ последней строкой stderr вида `reason=<имя>`, плюс
# человекочитаемое описание строкой выше.
#
#   reason=конфиг_не_читается   — файла нет или JSON не парсится
#   reason=конфиг_битый         — JSON есть, но нет port / healthz_window_sec, или не целое
#   reason=чужой_слушатель       — порт занят не нашим прокси (healthz не 200)
#   reason=ребёнок_погиб         — прокси умер на старте (kill -0 отрицателен)
#   reason=healthz_молчит        — живой ребёнок не ответил 200 за healthz_window_sec
kill_child() {  # <pid>  — SIGTERM, через 0.3с SIGKILL
  local pid="${1:-}"
  [ -n "$pid" ] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  kill -TERM "$pid" 2>/dev/null || true
  sleep 0.3
  kill -0 "$pid" 2>/dev/null || return 0
  kill -KILL "$pid" 2>/dev/null || true
}

# Healthz-проба. Возвращает:
#   0 — 200 OK (это наш прокси)
#   1 — connection refused или сеть недоступна (порт свободен)
#   2 — ответ пришёл, но не 200 (чужой слушатель)
#   2 — таймаут 1с без ответа (чужой слушатель, не отвечающий)
# 127 — node не найден
probe_healthz() {
  local p="${1:-}"
  node -e "
    const http = require('http');
    const req = http.get({
      hostname: '127.0.0.1',
      port: ${p},
      path: '/healthz',
      timeout: 1000
    }, res => {
      process.exit(res.statusCode === 200 ? 0 : 2);
    });
    req.on('error', () => process.exit(1));
    req.on('timeout', () => { req.destroy(); process.exit(2); });
  " 2>/dev/null
  local rc=$?
  [ "$rc" -le 2 ] || return 127
  return "$rc"
}

# Разрешение конфига: абсолютный — как есть, относительный — от $HERE, пусто — умолчание.
resolve_config() {
  local arg="${1:-}"
  if [ -z "$arg" ]; then
    printf '%s\n' "$HERE/config/metering.json"
  elif [[ "$arg" = /* ]]; then
    printf '%s\n' "$arg"
  else
    printf '%s\n' "$HERE/$arg"
  fi
}

# Главный обработчик --check-metering. Никогда не возвращает 0 при ошибке — отказ
# ВСЕГДА идёт с названной причиной. Молчаливое 1 — дефект, который барьер красит.
run_check_metering() {
  local cfg hw port proxy_dir pid_file child_pid_rc proxy_script log_file
  cfg="$(resolve_config "${CONFIG_ARG:-}")"

  # 1. Конфиг читается. reason=конфиг_не_читается / причина_в_jq
  if [ ! -f "$cfg" ]; then
    printf 'ОТКАЗ: конфиг не найден: %s\n' "$cfg" >&2
    printf 'reason=конфиг_не_читается\n' >&2
    exit 1
  fi
  # JSON парсится через node: зависимостей на jq в package.json нет, и тащить
  # сюда тот же подстановщик, что в самом прокси, неправильно.
  local parsed
  parsed="$(node -e "
    const fs = require('fs');
    try {
      const c = JSON.parse(fs.readFileSync(process.argv[1], 'utf8'));
      if (typeof c.port !== 'number' || !Number.isInteger(c.port) || c.port <= 0 || c.port > 65535) {
        process.stderr.write('port отсутствует, не целое или вне 1..65535'); process.exit(2);
      }
      if (typeof c.healthz_window_sec !== 'number' || !Number.isInteger(c.healthz_window_sec) || c.healthz_window_sec <= 0) {
        process.stderr.write('healthz_window_sec отсутствует, не целое или не положительное'); process.exit(2);
      }
      process.stdout.write(c.port + ' ' + c.healthz_window_sec);
    } catch (e) {
      process.stderr.write(e.message); process.exit(1);
    }
  " "$cfg" 2>&1)" || {
    local rc=$?
    if [ "$rc" = "2" ]; then
      printf 'ОТКАЗ: конфиг %s битый: %s\n' "$cfg" "$parsed" >&2
      printf 'reason=конфиг_битый\n' >&2
    else
      printf 'ОТКАЗ: конфиг %s не читается: %s\n' "$cfg" "$parsed" >&2
      printf 'reason=конфиг_не_читается\n' >&2
    fi
    exit 1
  }
  port="${parsed% *}"
  hw="${parsed#* }"

  # 2. Пробуем healthz. 0 — наш жив; 2 — чужой слушатель; 1 — порт свободен. Контекст
  # `if`/`elif`/`else` отключает `set -e` внутри функции: иначе возврат 2 убил бы
  # процесс до проверки `prc`, и причина осталась бы не названной.
  local prc=0
  if probe_healthz "$port"; then
    return 0
  else
    prc=$?
  fi
  case "$prc" in
    2) printf 'ОТКАЗ: на порту %s чужой слушатель (healthz не отвечает как прокси)\n' "$port" >&2
       printf 'reason=чужой_слушатель\n' >&2
       exit 1 ;;
    127) printf 'ОТКАЗ: node не найден — healthz нечем опросить\n' >&2
           printf 'reason=healthz_молчит\n' >&2
           exit 1 ;;
  esac

  # 3. Поднимаем ребёнка. pid-файл — от пользовательского HOME, не от ZONE,
  # которую ниже переопределяет вход в сессию. XDG_CONFIG_HOME НЕ учитывается:
  # в фикстурах cold-start ставят `export HOME=$work` для герметичности, и
  # если XDG_CONFIG_HOME остался родительский (~/.config), pid-файл уедет
  # мимо work, и фикстура не найдёт ребёнка. HOME — единственная база:
  # `~/.config/dev-harness/proxy.pid` по контракту 005 §6 — это `~/.config/dev-harness`,
  # где `~` раскрывается в $HOME, а не в $XDG_CONFIG_HOME.
  proxy_script="$HERE/scripts/proxy/metering_proxy.ts"
  if [ ! -f "$proxy_script" ]; then
    printf 'ОТКАЗ: скрипт прокси не найден: %s\n' "$proxy_script" >&2
    printf 'reason=ребёнок_погиб\n' >&2
    exit 1
  fi
  proxy_dir="$HOME/.config/dev-harness"
  mkdir -p "$proxy_dir"
  pid_file="$proxy_dir/proxy.pid"
  log_file="$proxy_dir/proxy.log"
  rm -f "$pid_file"

  # nohup + & — ребёнок переживает завершение лаунчера. ВЫВОД уходит в файл, чтобы
  # любой шум прокси не подмешался в stderr лаунчера, иначе грeп причины фонил.
  nohup node "$proxy_script" --config "$cfg" >"$log_file" 2>&1 &
  local child_pid=$!
  echo "$child_pid" >"$pid_file"

  # 4. Ждём ответа healthz в окне hw секунд. ПОРЯДОК проверок важен: ребёнок умер —
  # выходим сразу, не дожидаясь окна (исход 3а). Живой молчащий — выходим по окну (3б).
  local deadline=$(( $(date +%s) + hw ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if ! kill -0 "$child_pid" 2>/dev/null; then
      printf 'ОТКАЗ: ребёнок погиб на старте (pid %s)\n' "$child_pid" >&2
      printf 'reason=ребёнок_погиб\n' >&2
      exit 1
    fi
    if probe_healthz "$port"; then
      return 0
    fi
    sleep 0.1
  done

  # 5. Окно истекло. Перед выходом — прибрать ребёнка, если он ещё жив: иначе
  # он будет висеть как зомби под pid-файлом, и следующий запуск решит, что прокси
  # уже поднят, а это будет враньё.
  if ! kill -0 "$child_pid" 2>/dev/null; then
    printf 'ОТКАЗ: ребёнок погиб на старте (pid %s)\n' "$child_pid" >&2
    printf 'reason=ребёнок_погиб\n' >&2
    exit 1
  fi
  kill_child "$child_pid"
  printf 'ОТКАЗ: healthz не ответил за %s с (pid %s жив)\n' "$hw" "$child_pid" >&2
  printf 'reason=healthz_молчит\n' >&2
  exit 1
}

# Модель передаётся ЯВНЫМ флагом, а не оставляется на роли `default`. Измерено на владельце:
# интерактивная сессия поднялась на Opus 4.8, которого в наших ролях моделей нет вовсе —
# TUI восстановил ранее выбранную модель поверх конфига, а `modelRoleStorage` у omp `global`,
# то есть выбор живёт в доме, а не в проекте. Непрогонные запуски при этом слушались конфига,
# поэтому расхождение было невидимым: заявленное принималось за фактическое.

# ── разбор аргументов ────────────────────────────────────────────────────────
PROJECT=""; PLAN=""; MODELS=""; RESUME=""; CONFIG_ARG=""; FABLE=0
CHECK_METERING=0
# РЕЖИМ ПРОЕКТА — ПРОБА (контракт 054, М2): исполняет код режима проекта
# (load_env → bootstrap_env → пин omp → резолвер И-1..И-6 → 4.3-проверка И-10 →
# раскладка ролей → промпт И-9) ДО exec omp и выходит rc 0 строкой `workshop
# PROBE OK: <репо>` и строкой `PROMPT: <файл>`. Один код режима — для `--probe`
# (CI/фикстуры) и для `./workshop <репо>` (живой); граница-3.
PROBE=0
while [ $# -gt 0 ]; do
  case "$1" in
    # Значение берётся проверкой, а не `shift` вслепую: `shift` при пустом списке возвращает
    # не ноль и под `set -e` убивал бы скрипт молча.
    --plan)   PLAN="${2:-}";   [ $# -ge 2 ] && shift ;;
    --models) MODELS="${2:-}"; [ $# -ge 2 ] && shift ;;
    # ПРОДОЛЖЕНИЕ СЕССИИ. Стенограмма живёт на диске в профиле, и `omp --resume <префикс>` её
    # поднимает. Разбирается ЗДЕСЬ, а не прокидывается в хвосте, по двум причинам.
    #
    # Первая: продолжение — это та же сессия. Согласие на работу было дано при старте той
    # сессии, и требовать план второй раз означало бы требовать согласие на то, что уже
    # согласовано: ритуал вместо механизма.
    #
    # Вторая: инвентарь сессии обязан быть тем же. Продолженная сессия с урезанными
    # инструментами не смогла бы дописать начатое, а с расширенными — обошла бы политику
    # подтверждений.
    -r|--resume) RESUME="${2:-}"; [ $# -ge 2 ] && shift ;;
    # РЕЖИМ ПРОВЕРКИ ПРОКСИ. Отдельный флаг, не вход в сессию: аргументы после него
    # НЕ интерпретируются как проект или `--plan`. Всё, что ниже — для talk/work.
    --check-metering) CHECK_METERING=1 ;;
    # ПРОБА РЕЖИМА ПРОЕКТА. Тот же путь, что и `<репо>`, но ДО `exec omp`: печатает
    # `workshop PROBE OK` и `PROMPT: <путь>` строками, и выходит rc 0. Используется
    # фикстурами и CI вместо живого запуска. Любой отказ по пути — rc 1 с
    # именованной фразой (P1..P7, P8, P9, W2 — дословно).
    --probe) PROBE=1 ;;
    # Путь к конфигу прокси. Имеет смысл ТОЛЬКО под --check-metering; вне его режим
    # отвергает значение как нераспознанное, чтобы не плодить скрытых путей.
    --config) CONFIG_ARG="${2:-}"; [ $# -ge 2 ] && shift ;;
    # ЗАПРЕТ-ПОЛИТИКИ. Режим входа — политика подтверждений (контракт 002, критерий 1), и
    # снять её одним словом командной строки нельзя: флаг, затирающий always-ask, обходит
    # весь замок, который прежде держался инвентарём. Поэтому такие флаги не прокидываются
    # в omp хвостом `"$@"`, а ОТКАЗЫВАЮТСЯ здесь, с названным именем флага. Держит
    # `scripts/check_approval.sh`.
    # КЛАПАН ВЛАДЕЛЬЦА. Один вход снимает always-ask: явный `--yolo` передаёт omp
    # `--approval-mode yolo` и печатает в баннере «слово владельца». Конфиг не правится
    # — политика по умолчанию остаётся always-ask для всех, кто не сказал слово
    # (контракт 002 v5, критерий 1). Расширение `*` в glob ниже НЕ ловит ровно `--yolo`:
    # `case` берёт первое совпадение, и точная ветка стоит раньше glob.
    --yolo) YOLO=1 ;;
    # КОНСУЛЬТАНТ. Параллельная совещательная сессия на семействе fable (config/agent_models.json), read-only
    # (без edit/write/lsp) — дерево не трогает, с рабочим оркестратором не сталкивается.
    --fable) FABLE=1 ;;
    --approval-mode*|--approvals*|--yolo*|--dangerously-skip-permissions*) die "флаг $1 затирает политику подтверждений. Режим входа — always-ask из .omp/config.yml (контракт 002, критерий 1), и командная строка его не отменяет — клапан владельца называется ровно «--yolo»" ;;
    -*)     break ;;
    *)      [ -z "$PROJECT" ] && PROJECT="$1" || break ;;
  esac
  shift
done

# ── отдельный вход: --check-metering ─────────────────────────────────────────
# Стоит первым, до прогрузки `.env`, сессионных ролей и HOME. Режиму нужен ТОЛЬКО
# конфиг и порт, и никакая сессионная инициализация не должна между ними стоять:
# иначе сбой в одном месте прятал бы причину другого.
if [ "$CHECK_METERING" = "1" ]; then
  run_check_metering
  exit $?
fi

RESUME_ARGS=()
if [ -n "$RESUME" ]; then
  RESUME_ARGS=(--resume "$RESUME")
fi

# Клапан владельца `--yolo` поднимает YOLO=1 при разборе argv, и здесь эти
# `--approval-mode yolo` собираются в массив, который позже впрыскивается в
# команду запуска omp. Конфиг при этом не правится — политика по умолчанию
# остаётся always-ask (контракт 002 v5, критерий 1).
YOLO_ARGS=()
if [ "${YOLO:-0}" = "1" ]; then
  YOLO_ARGS=(--approval-mode yolo)
fi

# ── оверлей моделей ──────────────────────────────────────────────────────────
# Смена модели живой сессии — не правка конфига, а ЯВНЫЙ флаг запуска. Так видно в баннере,
# на чём идёт сессия, и так же выясняется, чем она отличалась, когда результат разошёлся.
#
# Оверлей ссылается на СЕМЕЙСТВА (`slow: "@opus"`), а версия живёт одной строкой в
# config/agent_models.json (секция models, слово владельца 2026-09-26). omp про семейства
# не знает, поэтому ему отдаётся РАЗВЁРНУТАЯ копия в зоне сессии; разворачивает генератор
# (`--resolve-overlay`) — разбор ссылки один на репозиторий. Литеральный id проходит как есть.
OVERLAY=()
MODELS_SRC=""
if [ -n "$MODELS" ]; then
  [ -f "$MODELS" ] || [ -f "$HERE/$MODELS" ] || die "оверлея моделей нет: $MODELS"
  [ -f "$MODELS" ] && MODELS="$(cd "$(dirname "$MODELS")" && pwd)/$(basename "$MODELS")" || MODELS="$HERE/$MODELS"
  MODELS_SRC="$MODELS"
  mkdir -p "$ZONE"
  node "$HERE/scripts/gen-harness.ts" --resolve-overlay "$MODELS_SRC" > "$ZONE/models-overlay.yml" \
    || die "оверлей $MODELS_SRC не развёрнут — ссылка на семейство, которого нет в config/agent_models.json (секция models)"
  [ -s "$ZONE/models-overlay.yml" ] || die "оверлей $MODELS_SRC развёрнут в пустой файл"
  MODELS="$ZONE/models-overlay.yml"
  OVERLAY=(--config "$MODELS")
fi

# ── инвентарь: один набор для всех входов ──────────────────────────────────
# Прежняя редакция держала два инвентаря: `TALK_TOOLS` без инструментов записи и `WORK_TOOLS`
# с полным набором. Это была попытка выстроить режим через ОТСУТСТВИЕ, и она провалилась:
# `bash` нужен и в разговоре (замеры — часть работы), а `lsp` и `task` обходили бы режим через
# субагента. Теперь режим держит политика `always-ask` в `.omp/config.yml`, и инвентарь один.
#
# `read, grep, glob, web_search, todo` — без них разговор вслепую, замеры нечем
# считать. `edit, write, bash, lsp, task` — для работы. Каждый инструмент в `always-ask`
# СПРАШИВАЕТ разрешения перед вызовом, и решение принимается живой сессией.
#
# `inspect_image` убран из инвентаря по решению владельца (Н-20): модель сессии
# текстовая (тир default, config/agent_models.json), инструмент без глаз — тихий брак. Вернуть при появлении
# vision-модели на роли сессии.
#
# `wait` — блокировка до settle своего job'а/сообщения субагента; замена удалённого
# в omp 18.3.1 `hub` (Н-105 обращён: инструмента hub в omp больше нет). Без wait
# в --tools сессия не получает инструмент вовсе.
TOOLS="read,edit,write,bash,grep,glob,lsp,web_search,task,todo,wait"

# ── работа НАД инструментом ──────────────────────────────────────────────────
if [ -z "$PROJECT" ]; then
  # `--plan` остаётся опциональным указанием предмета. Если передан — проверяется файл.
  # Не передан — сессия стартует без явного предмета, и предмет согласуется в живой сессии
  # через `always-ask` на первом же действии.
  if [ -n "$PLAN" ] && [ -z "$RESUME" ]; then
    [ -f "$PLAN" ] || die "файла плана нет: $PLAN"
    [ -s "$PLAN" ] || die "файл плана пуст: $PLAN. Пустой план — согласие ни на что"
    PLAN="$(cd "$(dirname "$PLAN")" && pwd)/$(basename "$PLAN")"
  fi
  load_env "$HERE"
  bootstrap_env
  require_metering "$HERE"
  export HOME="$ZONE"; mkdir -p "$HOME"
  PROMPT_FILE="$HOME/session-prompt-$SESSION_ROLE.md"
  node "$HERE/scripts/gen-harness.ts" --prompt "$SESSION_ROLE" > "$PROMPT_FILE" \
    || die "не удалось получить промпт роли $SESSION_ROLE"
  if [ "$FABLE" = "1" ]; then
    # Модель — семейство `fable` из config/agent_models.json (секция models), не литерал:
    # версия правится там одной строкой. Читается grep'ом, как session_model() читает
    # конфиг: этот путь не зовёт node (формат — одна пара «ключ: значение» на строку).
    LIVE_MODEL="$(grep -oE '^\s+"fable":\s*"[^"]+"' "$HERE/config/agent_models.json" | sed 's/.*"\(.*\)"/\1/')"
    [ -n "$LIVE_MODEL" ] || die "семейство fable не объявлено в config/agent_models.json (секция models)"
    TOOLS="read,grep,glob,bash,web_search,task,todo"
    FABLE_PROMPT="$HOME/session-prompt-fable.md"
    cp "$PROMPT_FILE" "$FABLE_PROMPT"
    printf '\n\n# РЕЖИМ КОНСУЛЬТАНТА (--fable)\nТы на %s ПАРАЛЛЕЛЬНО рабочей сессии-оркестратору (она ведёт живое дерево main). Роль СОВЕЩАТЕЛЬНАЯ: обсуждаешь архитектуру будущих майлстоунов и читаешь код, дерево НЕ трогаешь (инвентарь без edit/write/lsp). Любую правку/коммит делает рабочая сессия по слову владельца — ты только советуешь и разведываешь. НЕ коммить, НЕ пушь, НЕ спавни пишущих субагентов.\n' "$LIVE_MODEL" >> "$FABLE_PROMPT"
    PROMPT_FILE="$FABLE_PROMPT"
    printf '  РЕЖИМ FABLE  консультант read-only на %s — параллельно оркестратору\n' "$LIVE_MODEL" >&2
  fi
  printf '\n  СИСТЕМА-РАЗРАБОТЧИК — работа над инструментом\n' >&2
  printf '  политика     always-ask (инструменты спрашивают)\n' >&2
  if [ "${YOLO:-0}" = "1" ]; then
    printf '  РЕЖИМ: подтверждения СНЯТЫ, слово владельца\n' >&2
  fi
  printf '\n' >&2
  cd "$HERE"
  if [ -n "$PLAN" ]; then
    printf '  план         %s (%s строк)\n' "$PLAN" "$(wc -l < "$PLAN")" >&2
  else
    printf '  план         не указан — предмет согласуется в сессии через always-ask\n' >&2
  fi
  if [ -n "$RESUME" ]; then
    printf '  продолжение  сессия %s (план был предъявлен при её старте)\n' "$RESUME" >&2
  fi
  exec omp --profile "$PROFILE" --model "$LIVE_MODEL" "${OVERLAY[@]}" "${RESUME_ARGS[@]}" "${YOLO_ARGS[@]}" --append-system-prompt "$PROMPT_FILE" --tools "$TOOLS" "$@"
fi

# ── работа с проектом ────────────────────────────────────────────────────────
[ -d "$PROJECT" ] || die "каталога проекта нет: $PROJECT"
PROJECT="$(cd "$PROJECT" && pwd)"
git -C "$PROJECT" rev-parse --git-dir >/dev/null 2>&1 \
  || die "проект не git-репозиторий: $PROJECT. Одна сессия — один репозиторий, и его история обязана существовать"

# Пин версии харнеса принадлежит ПРОЕКТУ, а не инструменту. Подставить свой значило бы
# решить за проект вопрос, который он решил сам: 577 релизов за семь месяцев — достоинство
# инструмента разработчика и опасность производственного рантайма.
# ── окружение проекта ────────────────────────────────────────────────────────
# Прокси учёта поднимает ПРОЕКТ, и его адрес объявлен в окружении проекта. Без загрузки
# инструмент не нашёл бы адрес и вызовы MiniMax падали бы на первом же обращении.
#
# Уже заданное НЕ затирается, и это не вкус: у фабрики измерен ровно этот дефект — обёртки
# грузили `.env` через `set -a`, поэтому `ПЕРЕМЕННАЯ=значение npm run ...` молча не
# действовала для всего, что объявлено в `.env`, и поведение объясняли чем угодно, кроме
# настоящей причины.
load_env "$PROJECT"
bootstrap_env

# ── И-13: BOOTSTRAP KLETKI (контракт 054) — отсутствие .env и пина —─────────
# именованные отказы P8/P9 ДО сессии; контрмодели:
#   * P8 обязателен даже при экспортированной METERING_PROXY_URL (к12)
#   * P9 обязателен вместо мягкого skip «сверять не с чем» (к13)
# Probe судит НАЛИЧИЕ и грамматику (JSON; `.version` — непустая строка); сверка
# значения с omp --version — шаг живого режима (omp в probe/CI не заявлен).
# Граница-7: ни одна ветка НЕ создаёт файлы за проект.
ENV_FILE="$PROJECT/.env"
PIN_FILE="$PROJECT/config/harness_pin.json"
if [ ! -f "$ENV_FILE" ]; then
  printf 'profile ОТКАЗ: нет .env проекта: %s. Инструкция: создайте .env в корне репо — METERING_PROXY_URL=<адрес прокси учёта проекта>\n' "$ENV_FILE" >&2
  exit 1
fi
if [ ! -f "$PIN_FILE" ]; then
  printf 'profile ОТКАЗ: нет пина версии omp: %s. Инструкция: создайте config/harness_pin.json в корне репо — {"version": "<версия omp>"}\n' "$PIN_FILE" >&2
  exit 1
fi
if ! jq -e . "$PIN_FILE" >/dev/null 2>&1; then
  printf 'profile ОТКАЗ: файл не JSON: %s\n' "$PIN_FILE" >&2
  exit 1
fi
# `.version` ОБЯЗАНА быть непустой СТРОКОЙ (И-13): число, null, объект, массив —
# нарушение формы. Иначе «omp» сверяет версию как строку, а тест
# «`{"version":7}`» пройдёт, как и наблюдалось в обходе №6 (числовой пин).
pin_type="$(jq -r '.version | type' "$PIN_FILE")"
[ "$pin_type" = "string" ] || { printf 'profile ОТКАЗ: значение вне алфавита: version: <%s>\n' "$pin_type" >&2; exit 1; }
pin_version="$(jq -r '.version // empty' "$PIN_FILE")"
[ -n "$pin_version" ] || { printf 'profile ОТКАЗ: значение вне алфавита: version: пусто\n' >&2; exit 1; }

# Живой режим сверяет значение пина с `omp --version` (probe эту сверку НЕ
# делает — exec omp в пробе не заявлен, §Демаркация).
if [ "$PROBE" != "1" ]; then
  command -v jq >/dev/null 2>&1 || skip "нет jq — пин не прочитать"
  command -v omp >/dev/null 2>&1 || skip "нет omp — версию харнеса не сверить"
  want_ver="$pin_version"
  got_ver="$(omp --version 2>/dev/null | sed 's|^omp/||')"
  [ -n "$got_ver" ] || skip "omp --version пуст — сверять не с чем"
  [ "$want_ver" = "$got_ver" ] \
    || die "версия харнеса $got_ver, проект пинит $want_ver. Обновление наложением слоя, а не молча"
fi

# ── И-10: 4.3-проверка — литерал 'refuse' ───────────────────────────────────
# Проверка в репо проекта (НЕ в мастерской): `git -C <репо> config --local
# --get receive.denyCurrentBranch` обязан вернуть ЛИТЕРАЛЬНО «refuse»; пусто
# или иное (включая «updateInstead» — Н-143) — отказ W2 со значением в
# причине и командой-исправлением. Дефолт git НЕ принимается за исполнение
# слова владельца; настройка ОБЯЗАНА быть ЛОКАЛЬНОЙ в репо проекта (4.3 —
# `--local`, НЕ `--get`, который читает унаследованное от global/system и
# принимает подмену из HOME/.gitconfig за настройку клона).
#
# ДОПОЛНЕНИЕ 054-фикс-раунд 4 (адверсарий круг 2, класс W2): `git -C <репо>
# config --local` НЕ привязывает git к репо, если в окружении выставлен
# `GIT_DIR` — локальная настройка читается из чужого git-dir. Санируем
# окружение (отмена унаследованных GIT_*) И принудительно указываем
# `--git-dir="$PROJECT/.git"`, чтобы ни один путь разрешения конфига не ушёл
# мимо репо проекта.
saved_git_dir="${GIT_DIR-}"; saved_git_wt="${GIT_WORK_TREE-}"
saved_git_idx="${GIT_INDEX_FILE-}"; saved_git_cd="${GIT_COMMON_DIR-}"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
deny_val="$(git --git-dir="$PROJECT/.git" -C "$PROJECT" config --local --get receive.denyCurrentBranch 2>/dev/null || true)"
if [ -n "$saved_git_dir" ]; then export GIT_DIR="$saved_git_dir"; fi
if [ -n "$saved_git_wt" ]; then export GIT_WORK_TREE="$saved_git_wt"; fi
if [ -n "$saved_git_idx" ]; then export GIT_INDEX_FILE="$saved_git_idx"; fi
if [ -n "$saved_git_cd" ]; then export GIT_COMMON_DIR="$saved_git_cd"; fi
if [ "$deny_val" != "refuse" ]; then
  printf "workshop ОТКАЗ: receive.denyCurrentBranch='%s' в %s, ожидается 'refuse'. Исправление: git -C %s config receive.denyCurrentBranch refuse\n" \
    "$deny_val" "$PROJECT" "$PROJECT" >&2
  exit 1
fi

# ── М1: РЕЗОЛВЕР ПРОФИЛЯ (контракт 054, И-1..И-6; контракт 055, М1/М3) ───
# Резолвер ОТКАЗЫВАЕТ сам (P1..P7, И-11: лаунчер проксирует дословно); зовётся
# ДО раскладки ролей и компоновки промпта, чтобы любой отказ попал в баннер.
# `set -e` обходится через `|| prc=$?`: `|| true` ПОТЕРЯЛ бы настоящий rc —
# $? после строки стал бы rc от `true`, и отказ пропал бы молча (измерено при
# отладке к2). Аналогичный приём в run_check_metering, И-11.
# 055: stdout резолвера ПЕРЕХВАТЫВАЕТСЯ (а не уходит в /dev/null) — projectId
# нужен лаунчеру для построения PSTATE и имени баннера STATE/METERING (И-2/И-3/И-7).
MERGED_PROFILE_FILE="$(mktemp)"
prc=0
bash "$HERE/scripts/profile_resolver.sh" --repo "$PROJECT" > "$MERGED_PROFILE_FILE" 2>/tmp/probe-profile.err || prc=$?
if [ "$prc" -ne 0 ]; then
  cat /tmp/probe-profile.err >&2 || true
  rm -f /tmp/probe-profile.err "$MERGED_PROFILE_FILE"
  exit 1
fi
rm -f /tmp/probe-profile.err

# ── М1/И-1: санитизация projectId (контракт 055, Граница-3) ────────────────
# projectId — чужой ввод (слой проекта), вставляемый в путь. Вне класса
# `^[a-z0-9][a-z0-9_-]*$` → rc 1 W4 (значение названо, класс назван).
# Проверка ДО любого использования в пути; резолвер при этом уже зелёный
# (его И-4 projectId — непустая строка — не правится).
PROJECT_ID_VAL="$(jq -r '.projectId.value // empty' "$MERGED_PROFILE_FILE")"
[ -n "$PROJECT_ID_VAL" ] || { printf 'workshop ОТКАЗ: projectId пуст — слой проекта неполон\n' >&2; rm -f "$MERGED_PROFILE_FILE"; exit 1; }
if printf '%s' "$PROJECT_ID_VAL" | grep -Eqv '^[a-z0-9][a-z0-9_-]*$'; then
  printf 'workshop ОТКАЗ: projectId вне класса пути: %s (класс ^[a-z0-9][a-z0-9_-]*$) — правь слой проекта\n' "$PROJECT_ID_VAL" >&2
  rm -f "$MERGED_PROFILE_FILE"
  exit 1
fi
rm -f "$MERGED_PROFILE_FILE"

# ── М1/И-2: PSTATE, пер-проектные HOME/скратч/state ────────────────────────
# `<base> = ${HARNESS_SCRATCH:-${XDG_STATE_HOME:-$HOME/.local/state}}`,
# вычисленный ДО подмены HOME (прецедент workshop:75-80 — та же болезнь
# «разрешившийся внутрь» уже закрыта в 028). Ни один из четырёх путей не
# содержит `dev-harness-sessions` (дев-зона мастерской).
#
# Фикс 055-к2 (адверсарий круг 1, блокер 3): PSTATE-base обязан быть
# АБСОЛЮТНЫМ путём. Относительный путь зависит от CWD запускающего, и при
# запуске из project checkout кладёт PSTATE внутрь судимого дерева —
# `relative-state/dev-harness-projects/<id>` создаётся прямо в репо проекта,
# и `check_no_leak` потом видит изменение. Дефолт `$HOME/.local/state` —
# абсолютный; проблема — только при заданном извне HARNESS_SCRATCH/
# XDG_STATE_HOME. Отказ ДО mkdir и экспорта HOME, чтобы ни одного файла в
# дереве не появилось.
PSTATE_BASE="${HARNESS_SCRATCH:-${XDG_STATE_HOME:-$HOME/.local/state}}"
case "$PSTATE_BASE" in
  /*) ;;
  *) printf 'workshop ОТКАЗ: PSTATE-base относительный: %s. XDG_STATE_HOME и HARNESS_SCRATCH обязаны быть абсолютным путём ВНЕ чекаута проекта (наследуемый дефолт %s — абсолютный)\n' "$PSTATE_BASE" "${HOME:-/}"/.local/state >&2
     exit 1 ;;
esac
PSTATE="$PSTATE_BASE/dev-harness-projects/$PROJECT_ID_VAL"
export HARNESS_SESSION_HOME="$PSTATE/home"
export HOME="$PSTATE/home"
export HARNESS_SCRATCH="$PSTATE/scratch"
export XDG_STATE_HOME="$PSTATE/state"

# ── расход живой сессии обязан считаться (только живой режим) ───────────────
# Probe: --probe живёт ТОЛЬКО для проверки окружения и компоновки промпта;
# require_metering зовётся в живом режиме, иначе проба валилась бы из-за
# отсутствующего прокси там, где валиться не о чем (CI-фикстура).
if [ "$PROBE" != "1" ]; then
  require_metering "$PROJECT"
fi

mkdir -p "$HOME" "$HARNESS_SCRATCH" "$XDG_STATE_HOME"
PROMPT_FILE="$HOME/session-prompt-$SESSION_ROLE.md"
node "$HERE/scripts/gen-harness.ts" --prompt "$SESSION_ROLE" > "$PROMPT_FILE" \
  || die "не удалось получить промпт роли $SESSION_ROLE"

# ── И-9: правила доходят до промпта целиком и в порядке (роль → правила) ───
# В промпт идёт ТЕЛО роли + пустая строка + правила из AGENTS.md мастерской
# (gen-harness.ts --agents-rules И-14 — единственный читатель секции).
# AGENTS.md репо НЕ подмешивается — область репо читает сам omp (В3(а)).
if [ -f "$HERE/AGENTS.md" ]; then
  node "$HERE/scripts/gen-harness.ts" --agents-rules "$HERE/AGENTS.md" >> "$PROMPT_FILE" 2>/dev/null \
    || { printf 'FAIL секции правил нет: ## Правила, каждое из которых уже стоило время\n' >&2; exit 1; }
fi

# Роли разработчика кладутся в ПОЛЬЗОВАТЕЛЬСКИЙ каталог агентов внутри изолированного
# HOME сессии, а не в дерево проекта. Путь спрошен у самого omp
# (`omp agents unpack --help`): он читает агентов из `~/.omp/agent/agents` и `./.omp/agents`.
# Раскладка в проект добавляла бы ему файлы, которых он не объявлял, — проверено: гейт
# фабрики сразу назвал их необъявленными.
AGENTS="$HOME/.omp/agent/agents"
node "$HERE/scripts/gen-harness.ts" --into "$AGENTS" >/dev/null \
  || die "не удалось разложить роли разработчика"
node "$HERE/scripts/gen-harness.ts" --into "$AGENTS" --check >/dev/null \
  || die "роли разошлись с источником сразу после генерации"

# `--plan` остаётся опциональным указанием предмета. Если передан и это не продолжение —
# проверяется файл.
if [ -n "$PLAN" ] && [ -z "$RESUME" ]; then
  [ -f "$PLAN" ] || die "файла плана нет: $PLAN"
  [ -s "$PLAN" ] || die "файл плана пуст: $PLAN. Пустой план — согласие ни на что"
  PLAN="$(cd "$(dirname "$PLAN")" && pwd)/$(basename "$PLAN")"
fi

# ── М1/И-3: баннер STATE — печатается ДО пробы/живого старта ───────────────
printf 'STATE: %s\n' "$PSTATE"

# ── М3/И-7: METERING env + баннер ───────────────────────────────────────────
# Экспорты ПЕРЕД exec omp (к7/к8: живой субъект-стаб-omp пишет факт СВОЕГО
# окружения); баннер несёт строку дословно (grep -F в фикстурах).
export METERING_PROJECT="$PROJECT_ID_VAL"
export METERING_ROLE="$SESSION_ROLE"
printf 'METERING: project=%s role=%s\n' "$PROJECT_ID_VAL" "$SESSION_ROLE"

# ── М2/И-4: PID-лок ─────────────────────────────────────────────────────────
# Лок `$PSTATE/sessions/<hash8(realpath(корень репо))>.lock`; hash8 =
# `sha256 | cut -c1-8`. Каталог-лока хранит PID владельца в файле `pid`.
#
# Протокол владения (фикс 055-r4, адверсарий круг 4):
#   - Каталог БЕЗ pid-файла = LIVE (владелец в окне mkdir→pid, ещё не
#     опубликовал pid). Это закрывает race-window между mkdir и записью
#     pid: параллельный старт НЕ стирает чужой живой захват.
#   - Каталог + pid-файл с ПУСТЫМ или НЕЧИСЛОВЫМ содержимым = LIVE
#     (NOT-YET-PUBLISHED). Владелец между tmp+mv ещё не завершил атомарную
#     публикацию, либо pid-файл сиротский — битый лок НЕ блокирует
#     проект НАВСЕГДА (grace-период по mtime каталога, см. ниже).
#   - Каталог + pid-файл с числовым ЖИВЫМ pid = LIVE (отказ W3).
#   - Каталог + pid-файл с числовым МЁРТВЫМ pid + ЛОК СВЕЖИЙ (< grace) =
#     LIVE. Grace-период ЗАКРЫВАЕТ sequential-takeover race: 64
#     параллельных live-старта, победитель умирает в окне 10с shim-сна,
#     ЗАПАЗДАВШИЙ стартёр (CPU contention на `node gen-harness.ts`)
#     приходит через 1-15с ПОСЛЕ смерти победителя и видит мёртвый pid;
#     без grace он захватывает лок, обе сессии доходят до exec
#     (succ=2 — измерено 054-к6 адверсарием 3/3 на HEAD=40ab940).
#     С grace — mtime каталога ещё свежий, refuse W3. PID-reuse остаётся
#     остаточным риском (контракт 055 §Модель угроз).
#   - Каталог + pid-файл с числовым МЁРТВЫМ pid + ЛОК СТАРЫЙ (≥ grace)
#     = STALE (rm -rf, перезахват) — зависшая сессия не блокирует
#     проект навсегда.
#
# Атомарный захват каталога — `mkdir` (POSIX EEXIST при коллизии).
# Атомарная публикация pid — `tmp+mv` ВНУТРИ каталога-лока: пишем pid в
# `pid.tmp` (или pid.$$ для уникальности), затем `mv` (POSIX rename
# атомарен) переименовывает в `pid`. Файл `pid` либо отсутствует, либо
# содержит полный числовой pid — промежуточного «пустого» состояния нет.
# PID переживает exec (И-5); мёртвый процесс сам делает лок
# замещаемым после grace-периода (И-6).
LOCK_GRACE_SECONDS="${WORKSHOP_LOCK_GRACE_SECONDS:-60}"
REPO_REALPATH="$(cd "$PROJECT" && pwd -P)"
LOCK_HASH8="$(printf '%s' "$REPO_REALPATH" | sha256sum | cut -c1-8)"
LOCK_DIR="$PSTATE/sessions"
LOCK_FILE="$LOCK_DIR/$LOCK_HASH8.lock"
mkdir -p "$LOCK_DIR"
if [ -d "$LOCK_FILE" ]; then
  LOCK_HAS_PIDFILE=0
  LOCK_PID_VAL=""
  if [ -f "$LOCK_FILE/pid" ]; then
    LOCK_HAS_PIDFILE=1
    LOCK_PID_VAL="$(cat "$LOCK_FILE/pid" 2>/dev/null || true)"
  fi
  LOCK_DISPOSITION=""
  if [ "$LOCK_HAS_PIDFILE" = "0" ]; then
    # Каталог есть, pid-файла нет → LIVE (race window mkdir→pid).
    LOCK_DISPOSITION="live_no_pidfile"
  else
    case "$LOCK_PID_VAL" in
      '')
        # pid-файл существует, но пуст → STALE (сиротский лок, rm -rf).
        LOCK_DISPOSITION="stale_empty_pidfile"
        ;;
      *[!0-9]*)
        # Нечисловой pid → STALE (битый лок, rm -rf).
        LOCK_DISPOSITION="stale_non_numeric"
        ;;
      *)
        if kill -0 "$LOCK_PID_VAL" 2>/dev/null; then
          LOCK_DISPOSITION="live_alive"
        else
          LOCK_DISPOSITION="stale_dead"
        fi
        ;;
    esac
  fi
  # Grace-период (фикс 055-r4): мёртвый pid = LIVE, если каталог-лок
  # свежий (mtime < LOCK_GRACE_SECONDS). Это закрывает sequential-takeover
  # race в окне между смертью победителя и приходом запаздавшего
  # стартёра при 64 параллельных live-стартах с 10с shim-сном
  # (succ=2 — измерено 054-к6 3/3 на HEAD=40ab940). PID-reuse остаётся
  # остаточным риском (контракт 055 §Модель угроз).
  if [ "$LOCK_DISPOSITION" = "stale_dead" ]; then
    LOCK_DIR_MTIME="$(stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0)"
    LOCK_NOW="$(date +%s)"
    LOCK_AGE=$((LOCK_NOW - LOCK_DIR_MTIME))
    if [ "$LOCK_AGE" -lt "$LOCK_GRACE_SECONDS" ]; then
      LOCK_DISPOSITION="live_recently_dead"
    fi
  fi
  case "$LOCK_DISPOSITION" in
    live_no_pidfile)
      printf 'workshop ОТКАЗ: на корне %s уже идёт сессия (pid не объявлен, владелец в окне mkdir→pid). Вторая сессия на том же корне запрещена (Н-108): заверши её или работай в другом клоне\n' "$REPO_REALPATH" >&2
      exit 1
      ;;
    live_alive)
      printf 'workshop ОТКАЗ: на корне %s уже идёт сессия (pid %s). Вторая сессия на том же корне запрещена (Н-108): заверши её или работай в другом клоне\n' "$REPO_REALPATH" "$LOCK_PID_VAL" >&2
      exit 1
      ;;
    live_recently_dead)
      printf 'workshop ОТКАЗ: на корне %s недавно умерла сессия (pid %s, %s сек назад). Лок держится grace-период %s с после смерти владельца, чтобы НЕ пропустить вторую сессию в окне sequential-takeover (Н-108): подождите или удалите лок вручную\n' "$REPO_REALPATH" "$LOCK_PID_VAL" "$LOCK_AGE" "$LOCK_GRACE_SECONDS" >&2
      exit 1
      ;;
    stale_*)
      # STALE → прибираем каталог, чтобы живой режим мог переподнять.
      rm -rf "$LOCK_FILE" 2>/dev/null || true
      ;;
  esac
fi

# ── ПРОБА: ДО `exec omp`, печатает баннер пробы и выходит 0 ────────────────
# ТОТ ЖЕ код режима проекта, что и выше; единственная развилка — пропуск exec.
if [ "$PROBE" = "1" ]; then
  printf 'workshop PROBE OK: %s\n' "$PROJECT"
  printf 'PROMPT: %s\n' "$PROMPT_FILE"
  exit 0
fi

# ── М2/И-5: живой режим занимает лок — `mkdir` АТОМАРНО перед `exec omp` ──
# `mkdir` атомарен (POSIX): два параллельных live-старта оба видят
# отсутствие каталога и оба зовут mkdir; только один получает rc=0,
# второй — EEXIST. Победитель атомарно ПУБЛИКУЕТ pid через
# `printf > $LOCK_FILE/pid.tmp` + `mv $LOCK_FILE/pid.tmp $LOCK_FILE/pid`
# (POSIX rename атомарен): промежуточного «пустого pid-файла» нет.
# PID переживает exec (И-5); мёртвый процесс сам делает лок
# замещаемым после grace-периода (И-6).
LOCK_PID_TMP="$LOCK_FILE/pid.tmp.$$"
if ! mkdir "$LOCK_FILE" 2>/dev/null; then
  # Гонка потеряна: между нашим `rm -rf` мёртвого владельца (выше) и mkdir,
  # либо параллельный live-старт создал каталог. В обоих случаях — вторая
  # сессия; ищем pid победителя и отказываем с W3, иначе — аварийный отказ.
  if [ -f "$LOCK_FILE/pid" ]; then
    LIVE_LOCK_PID="$(cat "$LOCK_FILE/pid" 2>/dev/null || true)"
    case "$LIVE_LOCK_PID" in
      ''|*[!0-9]*) ;;
      *)
        if kill -0 "$LIVE_LOCK_PID" 2>/dev/null; then
          printf 'workshop ОТКАЗ: на корне %s уже идёт сессия (pid %s). Вторая сессия на том же корне запрещена (Н-108): заверши её или работай в другом клоне\n' "$REPO_REALPATH" "$LIVE_LOCK_PID" >&2
          exit 1
        fi
        ;;
    esac
  fi
  die "атомарный захват PID-лока не удался: $LOCK_FILE"
fi
# Атомарная публикация pid: tmp+mv. Пока tmp не mv'нут — pid-файла
# «нет» (читатели видят либо отсутствие, либо полное содержимое).
printf '%s\n' "$$" > "$LOCK_PID_TMP"
mv "$LOCK_PID_TMP" "$LOCK_FILE/pid" 2>/dev/null || {
  # mv провалился — конкурентный rm -rf или наша собственная tmp
  # коллизия. tmp убираем, lock остаётся тому, кто выиграл mkdir.
  rm -f "$LOCK_PID_TMP"
  die "атомарная публикация pid не удалась: $LOCK_FILE/pid"
}

printf '\n  СИСТЕМА-РАЗРАБОТЧИК — работа с проектом\n' >&2
printf '  проект       %s\n' "$PROJECT" >&2
printf '  харнес       omp/%s (пин проекта совпал)\n' "$got_ver" >&2
printf '  роль сессии  %s на %s\n' "$SESSION_ROLE" "$LIVE_MODEL" >&2
printf '  роли         %s\n' "$(ls -1 "$HERE/roles" | sed 's/\.md$//' | tr '\n' ' ')" >&2
printf '  политика     always-ask (инструменты спрашивают)\n' >&2
if [ "${YOLO:-0}" = "1" ]; then
  printf '  РЕЖИМ: подтверждения СНЯТЫ, слово владельца\n' >&2
fi
printf '  модели       %s\n' "$([ -n "$MODELS_SRC" ] && basename "$MODELS_SRC" || echo '.omp/config.yml (без оверлея)')" >&2
if [ -n "$PLAN" ]; then
  printf '  план         %s (%s строк)\n' "$PLAN" "$(wc -l < "$PLAN")" >&2
else
  printf '  план         не указан — предмет согласуется в сессии через always-ask\n' >&2
fi
if [ -n "$RESUME" ]; then
  printf '  продолжение  сессия %s (план был предъявлен при её старте)\n' "$RESUME" >&2
fi
printf '  инвентарь    полный, всегда-ask\n\n' >&2
cd "$PROJECT"
exec omp --profile "$PROFILE" --model "$LIVE_MODEL" "${OVERLAY[@]}" "${RESUME_ARGS[@]}" "${YOLO_ARGS[@]}" --append-system-prompt "$PROMPT_FILE" --tools "$TOOLS" "$@"
