#!/usr/bin/env bash
# Вход в систему-разработчика.
#
#   ./workshop                                   работа НАД инструментом
#   ./workshop <проект>                          РАЗГОВОР о проекте (по умолчанию)
#   ./workshop <проект> --work --plan <файл>     работа над проектом
#
# Режим по умолчанию — разговор, и это решение владельца от 2026-08-15. Причина
# названа им прямо: короткий вопрос или мысль вслух превращались в двадцатиминутную
# работу вместо обсуждения.
#
# Согласие на работу — АКТ ЗАПУСКА, а не слово исполнителя. Инвентарь инструментов у
# omp фиксируется при запуске: переключить режим внутри живой сессии нечем, а
# переключение по собственному решению было бы обещанием, не механизмом.
#
# Побочная выгода, которая важнее удобства: сессия работы стартует со СВЕЖИМ контекстом
# от НАПИСАННОГО плана, а не от переписки. Исполнитель не может «помнить, о чём
# договорились» — он обязан прочитать, что записано.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── один дом и один профиль на ВСЕ входы ─────────────────────────────────────
# Прежняя редакция заводила дом на каждую пару (проект, режим) и профиль на каждый режим.
# Учётные данные omp лежат В ПРОФИЛЕ, поэтому владельцу пришлось бы входить заново в каждой
# зоне — четыре входа вместо одного. Найдено на нём: первый запуск дал «No model selected»,
# потому что зона была пуста.
#
# Изоляция от ДОМАШНЕГО каталога машины остаётся: ею держится обещание режима разговора —
# `--tools` не закрывает MCP из глобального конфига, измерено 54 чужих инструмента вопреки
# allowlist. А изоляция входов ДРУГ ОТ ДРУГА не покупает ничего: разработчик один, ключи те
# же, а режим держится инвентарём, а не домом.
ZONE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.zones/dev"
PROFILE="dev"

die()  { printf 'ОТКАЗ: %s\n' "$*" >&2; exit 1; }
skip() { printf 'NOT_IMPLEMENTED: %s\n' "$*" >&2; exit 2; }

# ── окружение и учёт: ОДНА реализация на оба входа ───────────────────────────
# Две копии этой логики разошлись бы молча. Проверено на себе: проверка прокси стояла
# только в ветке проекта, и вход в сам инструмент после перевода живой сессии на провайдера
# с ключом переставал работать — вызовы падали бы на первом обращении.

# Уже заданное НЕ затирается. У фабрики измерен ровно этот дефект: обёртки грузили `.env`
# через `set -a`, поэтому `ПЕРЕМЕННАЯ=значение npm run ...` молча не действовала для всего,
# что объявлено в `.env`, и поведение объясняли чем угодно, кроме настоящей причины.
load_env() {
  [ -f "$1/.env" ] || return 0
  while IFS='=' read -r k v; do
    case "$k" in ''|'#'*) continue ;; esac
    k="${k%% *}"
    [ -n "${!k:-}" ] || export "$k=$(printf '%s' "$v" | sed 's/^["'"'"']//;s/["'"'"']$//')"
  done < "$1/.env"
}

# Живая сессия работает на роли `default`. Стоит она на провайдере с ключом — вызовы идут
# через прокси учёта, и без адреса сессия не заработает вовсе. Отказ при запуске дешевле
# отказа на середине работы: там уже потрачено время, а причина выглядит как ошибка модели.
require_metering() {
  local cfg="${MODELS:-$HERE/.omp/config.yml}" live
  live="$(grep -oE '^\s+default:\s*"[^"]+"' "$cfg" 2>/dev/null | sed 's/.*"\(.*\)"/\1/' || true)"
  [ -n "$live" ] || live="$(grep -oE '^\s+default:\s*"[^"]+"' "$HERE/.omp/config.yml" | sed 's/.*"\(.*\)"/\1/')"
  case "$live" in
    minimax/*)
      [ -n "${METERING_PROXY_URL:-}" ] || die "живая сессия на $live идёт через прокси учёта, а METERING_PROXY_URL не задана. Прокси поднимает проект: подними его и объяви адрес в $1/.env, либо возьми оверлей на другое семейство (--models config/models-claude.yml)" ;;
  esac
  LIVE_MODEL="$live"
}

# Модель передаётся ЯВНЫМ флагом, а не оставляется на роли `default`. Измерено на владельце:
# интерактивная сессия поднялась на Opus 4.8, которого в наших ролях моделей нет вовсе —
# TUI восстановил ранее выбранную модель поверх конфига, а `modelRoleStorage` у omp `global`,
# то есть выбор живёт в доме, а не в проекте. Непрогонные запуски при этом слушались конфига,
# поэтому расхождение было невидимым: заявленное принималось за фактическое.

# ── разбор аргументов ────────────────────────────────────────────────────────
PROJECT=""; MODE="talk"; PLAN=""; MODELS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --work) MODE="work" ;;
    --talk) MODE="talk" ;;
    # Значение берётся проверкой, а не `shift` вслепую: `shift` при пустом списке возвращает
    # не ноль и под `set -e` убивал бы скрипт молча.
    --plan)   PLAN="${2:-}";   [ $# -ge 2 ] && shift ;;
    --models) MODELS="${2:-}"; [ $# -ge 2 ] && shift ;;
    -*)     break ;;
    *)      [ -z "$PROJECT" ] && PROJECT="$1" || break ;;
  esac
  shift
done

# ── оверлей моделей ──────────────────────────────────────────────────────────
# Смена модели живой сессии — не правка конфига, а ЯВНЫЙ флаг запуска. Так видно в баннере,
# на чём идёт сессия, и так же выясняется, чем она отличалась, когда результат разошёлся.
OVERLAY=()
if [ -n "$MODELS" ]; then
  [ -f "$MODELS" ] || [ -f "$HERE/$MODELS" ] || die "оверлея моделей нет: $MODELS"
  [ -f "$MODELS" ] && MODELS="$(cd "$(dirname "$MODELS")" && pwd)/$(basename "$MODELS")" || MODELS="$HERE/$MODELS"
  OVERLAY=(--config "$MODELS")
fi

# ── инвентарь по режиму ──────────────────────────────────────────────────────
# `talk` держится ОТСУТСТВИЕМ инструментов, а не просьбой не пользоваться.
#
# ЧИТАТЬ проект в разговоре можно полностью: `read` берёт файл, диапазон строк, каталог,
# архив и базу; `grep` ищет по дереву; `glob` перечисляет пути. Разговор без чтения был бы
# разговором вслепую.
#
# Нет `bash`: с ним разговор перестаёт быть разговором — `echo > файл` правит дерево не хуже
# редактора. Нет `lsp`: он применяет правки кода. Нет `task`: субагент принёс бы свой
# инвентарь и обошёл бы запрет через него.
#
# Цена названа честно: нельзя ВЫПОЛНИТЬ команду, то есть нельзя посчитать прогоном. Если
# ответ требует замера — замер часть работы, и на него нужно согласие.
TALK_TOOLS="read,grep,glob,web_search,inspect_image,todo"
WORK_TOOLS="read,edit,write,bash,grep,glob,lsp,web_search,inspect_image,task,todo"

# ── работа НАД инструментом: свой дом, полный инвентарь ──────────────────────
if [ -z "$PROJECT" ]; then
  [ "$MODE" = "talk" ] || die "над инструментом работают в его собственном каталоге; режим здесь не выбирают"
  load_env "$HERE"
  require_metering "$HERE"
  export HOME="$ZONE"; mkdir -p "$HOME"
  printf '\n  СИСТЕМА-РАЗРАБОТЧИК — работа над инструментом\n' >&2
  printf '  сессия       %s\n' "$LIVE_MODEL" >&2
  printf '  каталог      %s\n' "$HERE" >&2
  printf '  роли         %s\n' "$(ls -1 "$HERE/roles" 2>/dev/null | sed 's/\.md$//' | tr '\n' ' ')" >&2
  printf '  проект       нет: правки кода проектов отсюда не делают\n\n' >&2
  cd "$HERE"
  exec omp --profile "$PROFILE" --model "$LIVE_MODEL" "${OVERLAY[@]}" --tools "$WORK_TOOLS" "$@"
fi

# ── работа с проектом ────────────────────────────────────────────────────────
[ -d "$PROJECT" ] || die "каталога проекта нет: $PROJECT"
PROJECT="$(cd "$PROJECT" && pwd)"
git -C "$PROJECT" rev-parse --git-dir >/dev/null 2>&1 \
  || die "проект не git-репозиторий: $PROJECT. Одна сессия — один репозиторий, и его история обязана существовать"

# Пин версии харнеса принадлежит ПРОЕКТУ, а не инструменту. Подставить свой значило бы
# решить за проект вопрос, который он решил сам: 577 релизов за семь месяцев — достоинство
# инструмента разработчика и опасность производственного рантайма.
# ── окружение проекта ────────────────────────────────────────────────────────
# Прокси учёта поднимает ПРОЕКТ, и его адрес объявлен в окружении проекта. Без загрузки
# инструмент не нашёл бы адрес и вызовы MiniMax падали бы на первом же обращении.
#
# Уже заданное НЕ затирается, и это не вкус: у фабрики измерен ровно этот дефект — обёртки
# грузили `.env` через `set -a`, поэтому `ПЕРЕМЕННАЯ=значение npm run ...` молча не
# действовала для всего, что объявлено в `.env`, и поведение объясняли чем угодно, кроме
# настоящей причины.
load_env "$PROJECT"

PIN="$PROJECT/config/harness_pin.json"
[ -f "$PIN" ] || skip "у проекта нет пина версии харнеса ($PIN) — сверять не с чем"
command -v jq >/dev/null 2>&1 || skip "нет jq — пин не прочитать"
want_ver="$(jq -r '.version' "$PIN")"
got_ver="$(omp --version 2>/dev/null | sed 's|^omp/||')"
[ "$want_ver" = "$got_ver" ] \
  || die "версия харнеса $got_ver, проект пинит $want_ver. Обновление наложением слоя, а не молча"

# ── расход живой сессии обязан считаться ─────────────────────────────────────
# Живая сессия работает на роли `default`. Если она стоит на провайдере с ключом, её вызовы
# идут через прокси учёта, и без адреса прокси сессия не заработает вовсе. Отказ здесь дешевле
# отказа на середине работы: там уже потрачено время, а причина выглядит как ошибка модели.
require_metering "$PROJECT"

export HOME="$ZONE"; mkdir -p "$HOME"

# Роли разработчика кладутся в ПОЛЬЗОВАТЕЛЬСКИЙ каталог агентов внутри изолированного
# HOME сессии, а не в дерево проекта. Путь спрошен у самого omp
# (`omp agents unpack --help`): он читает агентов из `~/.omp/agent/agents` и `./.omp/agents`.
# Раскладка в проект добавляла бы ему файлы, которых он не объявлял, — проверено: гейт
# фабрики сразу назвал их необъявленными.
AGENTS="$HOME/.omp/agent/agents"
node "$HERE/scripts/gen-harness.ts" --into "$AGENTS" >/dev/null \
  || die "не удалось разложить роли разработчика"
node "$HERE/scripts/gen-harness.ts" --into "$AGENTS" --check >/dev/null \
  || die "роли разошлись с источником сразу после генерации"

# ── согласие на работу ───────────────────────────────────────────────────────
if [ "$MODE" = "work" ]; then
  [ -n "$PLAN" ] || die "режим работы требует плана: --plan <файл>. План в переписке не переживает сессию"
  [ -f "$PLAN" ] || die "файла плана нет: $PLAN"
  [ -s "$PLAN" ] || die "файл плана пуст: $PLAN. Пустой план — согласие ни на что"
  PLAN="$(cd "$(dirname "$PLAN")" && pwd)/$(basename "$PLAN")"
fi

printf '\n  СИСТЕМА-РАЗРАБОТЧИК — %s\n' "$([ "$MODE" = work ] && echo 'РАБОТА над проектом' || echo 'РАЗГОВОР о проекте')" >&2
printf '  проект       %s\n' "$PROJECT" >&2
printf '  харнес       omp/%s (пин проекта совпал)\n' "$got_ver" >&2
printf '  сессия       %s\n' "$LIVE_MODEL" >&2
printf '  роли         %s\n' "$(ls -1 "$HERE/roles" | sed 's/\.md$//' | tr '\n' ' ')" >&2
printf '  модели       %s\n' "$([ -n "$MODELS" ] && basename "$MODELS" || echo '.omp/config.yml (без оверлея)')" >&2
if [ "$MODE" = "work" ]; then
  printf '  план         %s (%s строк)\n' "$PLAN" "$(wc -l < "$PLAN")" >&2
  printf '  инвентарь    полный\n\n' >&2
  cd "$PROJECT"
  exec omp --profile "$PROFILE" --model "$LIVE_MODEL" "${OVERLAY[@]}" --tools "$WORK_TOOLS" "$@"
fi
printf '  читать       можно: read (файл, диапазон, каталог), grep, glob\n' >&2
printf '  править      нельзя ФИЗИЧЕСКИ: нет edit, write, bash, lsp, task\n' >&2
printf '  выполнять    нельзя: значит нельзя ПОСЧИТАТЬ прогоном — замер часть работы\n' >&2
printf '  дальше       план файлом, затем ./workshop %s --work --plan <файл>\n\n' "$PROJECT" >&2
cd "$PROJECT"
exec omp --profile "$PROFILE" --model "$LIVE_MODEL" "${OVERLAY[@]}" --tools "$TALK_TOOLS" "$@"
