#!/usr/bin/env bash
# scripts/gitw — обёртка git-обмена (push/fetch/pull) с pre-exchange гардом
# цели (контракт 045, И-1..И-9). Судит КАЖДУЮ непустую форму цели ДО
# исполнения обмена; несовпадение с каноном = rc 1 F1 с именованной
# фактической целью; недостижимость авторитета = rc 1 F2; неизвестный
# глобальный флаг = rc 1 F3; не-обменные подкоманды и не-git PATH — exec.
#
# Коды возврата:
# 0 — обмен исполнен (или не-обменная подкоманда прозрачно передана через И-8)
# 1 — отказ: F1 URL не канонический, F2 авторитет недоступен, F3 неизвестный глобальный флаг
# 2 — NOT_IMPLEMENTED: настоящий git не найден в PATH (И-1, граница-1)
set -uo pipefail

# ── И-1: разрешение настоящего git ──────────────────────────────────────────
# Первый `git` в PATH, чей realpath ≠ realpath самой обёртки. Не найден →
# rc 2 NOT_IMPLEMENTED. Граница-1 (вариант а frontier): суждение на execve.
SELF_REAL="$(readlink -f "$0" 2>/dev/null || /usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
REAL=""
IFS_SAV="$IFS"
IFS=':'
for d in $PATH; do
  IFS="$IFS_SAV"
  [ -z "$d" ] && d="."
  [ -x "$d/git" ] || continue
  cand="$(readlink -f "$d/git" 2>/dev/null || /usr/bin/readlink -f "$d/git" 2>/dev/null || echo "$d/git")"
  if [ "$cand" != "$SELF_REAL" ]; then
    REAL="$d/git"
    break
  fi
done
IFS="$IFS_SAV"
if [ -z "$REAL" ]; then
  printf 'gitw NOT_IMPLEMENTED: настоящий git не найден\n' >&2
  exit 2
fi

# ── И-5: канонический URL — ЕДИНСТВЕННАЯ константа ───────────────────────────
# Ручка GIT_EXCHANGE_GUARD_CANONICAL заменяет её целиком (граница-4: ровно
# одна обходная ручка). Сравнение — ТОЛЬКО буквальное равенство целых строк
# (И-5: норма-класс 037 accept_task_commit).
CANON="${GIT_EXCHANGE_GUARD_CANONICAL:-ssh://git@github.com/a3ka/dev-harness.git}"

# ── И-6: санитизация печати ─────────────────────────────────────────────────
# Каждый байт <0x20 или =0x7F → '?'. Подделка строк отказа переносом строки
# внутри URL невозможна (управляющий байт гасится на печати).
sanitize() {
  printf '%s' "$1" | LC_ALL=C tr '\001-\037\177' '?'
}

# ── И-2: разбор argv, fail-closed ───────────────────────────────────────────
# Ведущие глобальные флаги потребляются по arity; первый не-флаг = подкоманда.
# НЕраспознанный ведущий флаг → rc 1 F3 с именем флага (подкоманда не
# определена надёжно → несудимый обмен запрещён).
orig=( "$@" )
ctx=()
cfg=()
n=${#orig[@]}
i=0
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  case "$a" in
    -C|--git-dir|--work-tree|--namespace|--exec-path)
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2; exit 1; }
      ctx+=("$a" "${orig[$((i+1))]}")
      i=$((i+2))
      ;;
    -c)
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2; exit 1; }
      cfg+=("$a" "${orig[$((i+1))]}")
      i=$((i+2))
      ;;
    --git-dir=*|--work-tree=*|--namespace=*|--exec-path=*)
      ctx+=("$a")
      i=$((i+1))
      ;;
    --bare|--no-pager|--paginate|--no-replace-objects|--literal-pathspecs|--no-optional-locks)
      ctx+=("$a")
      i=$((i+1))
      ;;
    -*)
      # Неизвестный ведущий флаг: arity неизвестна, подкоманда ненадёжна.
      printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2
      exit 1
      ;;
    *)
      sub="$a"
      i=$((i+1))
      break
      ;;
  esac
done

# ── И-3: судимые подкоманды ─────────────────────────────────────────────────
# Ровно push/fetch/pull. Всё прочее — прозрачная передача (И-8).
case "$sub" in
  push|fetch|pull) ;;
  *) exec "$REAL" "${orig[@]}" ;;
esac

# ── И-4a: repository argument — URL / SCP / path / bare-name / --repo= ────
# Git docs (gitrepository-layout / git-push «repository argument»): четыре
# синтаксические формы:
#   URL-like : содержит '://'
#   SCP-like : содержит ':', при этом до ':' нет '/'
#              (т.е. `[user@]host:path` — gitrepository-layout; иначе форма
#              считается path-like с двоеточием в имени)
#   path-like: начинается с /, ./ или ../
#   bare     : всё прочее — потенциальное имя настроенного remote (см. И-4б)
# Имя, не попавшее ни в одну форму, но не настроенное как remote — настоящий
# git сам откажет, обёртка передаёт вызов (канарейка г7-класса, И-2).
#
# РАСШИРЕНИЕ (адверсарий 045-v3 confirm, полное закрытие):
# `git push --repo=<repository>` (`git help push`: «equivalent to the
# <repository> argument. If both are specified, the command-line argument
# takes precedence»). Распознаётся ДО generic `-*`-skip — без этого живой
# обход: `--repo=evil --all` молча проглатывался, target оставался пуст,
# обёртка проверяла канонический origin, настоящий git исполнял push в
# неканонический remote `evil`.
#
# ПРЕЦЕДЕНТ (man git-push): «the command-line argument takes precedence».
# Позиционная цель СИЛЬНЕЕ --repo=: `push --repo=origin <evil-path>` реально
# уходит в <evil-path> (замер арх-разведки 045-2 живьём на git 2.55).
# Реализация БУКВАЛЬНОГО приоритета --repo открыла бы НОВЫЙ обход
# (--repo=origin отмывает злой позиционный, клетка г17ж + стаб repoprio
# архитектора). Поэтому --repo=* запоминается в repo_value и применяется
# ТОЛЬКО если позиционная цель не найдена; последний --repo=* выигрывает
# (соответствует семантике git при множественных --repo=).
#
# Раздельная форма `--repo <value>` (045-v3 confirm, полное закрытие):
# предыдущий резон «`-*`-skip потребляет `--repo`, `<value>` падает в
# bare_name и проходит И-4б как именованный remote» оказался ЛОЖНЫМ
# (арх-проверка живьём, репро в /tmp/dev-harness-verify/scratch/
# impl045-v2-repro.sh). `<value>` действительно попадает в bare_name,
# но это ЛОМАЕТ цикл (break) ДО позиционной цели. Итог: `gitw push
# `--repo origin <evil-path>` проверяет origin (canonical, pass), реальный
# git пушит в <evil-path> (man git-push «command-line argument takes
# precedence»). ТО ЖЕ предметное поле, что и equals-форма: «позиционная
# цель сильнее --repo», просто эксплуатируется через раздельный токен.
#
# Фикс: arm `--repo)` arity 2 — ЗАПОМНИТЬ значение в repo_value (как и
# equals-форма), НЕ выставлять target/bare_name и НЕ break'ать цикл
# (позиционная цель ОБЯЗАНА выиграть; пост-цикл классифицирует
# repo_value той же логикой, что и equals-форма). Защита от выхода за
# массив: `--repo` последним токеном → fail-closed отказ с явным
# сообщением (без неё `${orig[$((i+1))]}` под Bash ≥4.4 на пустой
# индекс читает пустую строку молча — симптом «призрачной цели»,
# пустой repo_value проваливает fallback в дефолтный origin и
# восстанавливает обход). Стаб reposepskip архитектора (Н-39) ловит
# «оба токена пропустить» — arm явно потребляет оба токена за раз,
# отдельной правки стаба не требует.
#
# СХЛОПЫВАНИЕ arm `*:*)` (045-v3 confirm, г18, завис→обход):
# предыдущая редакция разбирала scp-like vs path-with-colon через
# внутренний `*/*) ;;` (slash-before-colon → не scp-like). ДВА дефекта:
#   (a) ЗАВИС: `*/*) ;;` не двигал индекс → токен `dir/sub:branch`
#       крутил цикл вечно (rc124 под timeout 5s).
#   (b) ПРЕВРАЩЕНИЕ ЗАВИСА В ОБХОД: даже фикс «`i=$((i+1))`»
#       (промежуточный вариант) открывал обход — `dir/sub:branch` шёл
#       дальше, real git трактовал его как repository + refspec,
#       пушил в `dir/sub` с созданием ветки `branch` на неканоническом
#       получателе (architect, замер живьём git 2.55).
# Коренное исправление (architect, замерено дважды): ПЕРВЫЙ непозиционный
# токен у git push ВСЕГДА repository-цель — refspec физически не может
# стоять первым позиционным, repository всегда перед ним (man git-push).
# Сложная классификация scp-vs-path БЕСПОЛЕЗНА и ОПАСНА (две описанных
# ловушки в одной конструкции). Схлопываем arm `*:*)` целиком в
# «содержит `/` → это цель, break»: `dir/sub:branch`, `dir/sub`,
# `user@host:path/with/slash` — ВСЕ идут в target и ОБЯЗАНЫ пройти И-5.
# Без `/` (чистый scp `host:repo.git`, чистый bare `origin`) → fallback
# на default-`*` (bare_name → И-4б, проверка настроенного remote).
# URL-like (`*://*`) и path-like (`/*|../*|./*`) классификации СОХРАНЕНЫ
# — они верны и не имеют описанных ловушек; трогаем только `*:*)` arm.
#
# ── И-4в (round2): цель из настроенного remote С УЧЁТОМ git-config-резолюции
# ─────────────────────────────────────────────────────────────────────────────
# (закрытие живых обходов через git-config-based НЕЯВНОЕ разрешение цели —
# адверсарий 045 round2: pushRemote/pushDefault/branch.remote/fetch --all)
#
# Git применяет конфиг-резолюцию при ОТСУТСТВИИ явной/--repo цели
# (`git help config`, branch.<name>.remote; `git help push`):
#   push:    branch.<current>.pushRemote → remote.pushDefault
#            → branch.<current>.remote → origin
#   pull:    branch.<current>.remote → origin
#   fetch:   branch.<current>.remote → origin (single-remote)
#            --all / --multiple — обмен с КАЖДЫМ настроенным remote
#            одновременно (`git help fetch`: «Fetch all remotes, except for
#            the ones that have the remote.<name>.skipFetchAll configuration
#            variable set»)
# Текущая ветка = `git symbolic-ref --quiet --short HEAD`; detached HEAD
# (rc≠0) — branch-специфичные ключи НЕ применяются, остаётся
# remote.pushDefault (push) / origin (fetch/pull).
#
# Решение: обёртка вычисляет тот же список целей, что и git, и проверяет
# КАЖДУЮ перед исполнением. Хотя бы одна не прошла — отказ всему обмену
# (fail-closed, никаких частичных обменов: «fetch --all» с одним evil-remote
# отказывает ЦЕЛИКОМ, не обменивается с origin в обход evil).
#
# Приоритеты резолюции внутри блока: bare_name (явный аргумент пользователя
# или значение --repo) → конфиг-цепочка по `$sub`. Для multi-remote берётся
# `git remote` (список ВСЕХ настроенных remote), bare_name не учитывается —
# --all/--multiple по семантике git работают со ВСЕМИ remote, не с
# переданными именами (прецедент архитектора).
target=""
bare_name=""
repo_value=""
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  case "$a" in
    --repo)
      # Раздельная форма arity-2 (полное закрытие 045-v3 confirm, см. шапку).
      # Без break: позиционная цель ОБЯЗАНА выиграть (прецедент выше).
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: --repo без значения\n' >&2; exit 1; }
      repo_value="${orig[$((i+1))]}"
      i=$((i+2))
      ;;
    --repo=*)
      # Равн-форма: запомнить VALUE, НЕ выставлять target/bare_name —
      # позиционная цель должна выиграть (man git-push «command-line
      # argument takes precedence»). Последний --repo=* выигрывает.
      repo_value="${a#--repo=}"
      i=$((i+1))
      ;;
    *://*|/*|../*|./*)
      target="$a"
      i=$((i+1))
      break
      ;;
    */*)
      # Содержит слэш — это цель (любая: scp-путь, path-with-colon,
      # явный локальный путь, выглядящий странно). ОПАСНОСТЬ arm `*:*)`
      # (двойная: завис + превращение зависа в обход) снята
      # схлопыванием — см. шапку И-4a. Без слэша (scp `host:repo.git`,
      # bare `origin`) — fallback на `*)` ниже.
      target="$a"
      i=$((i+1))
      break
      ;;
    -*) i=$((i+1)) ;;
    *)
      # Первый не-опциональный bare-аргумент — имя возможного remote.
      bare_name="$a"
      i=$((i+1))
      break
      ;;
  esac
done

# Fallback: если позиционная цель не найдена, использовать --repo=*
# (запомненное выше; если их было несколько — последнее, как и git).
# Та же логика, что и в основном цикле: URL/path/slash → target,
# иначе → bare_name (И-4б проверит настроенный remote).
if [ -z "$target" ] && [ -z "$bare_name" ] && [ -n "$repo_value" ]; then
  value="$repo_value"
  case "$value" in
    *://*|/*|../*|./*) target="$value" ;;
    */*) target="$value" ;;
    *) bare_name="$value" ;;
  esac
fi

if [ -z "$target" ]; then
  # ── И-4в: цель из настроенного remote с УЧЁТОМ git-config-резолюции ─────────
  # (см. шапку И-4в). Сначала — служебная разведка для вычисления списка
  # целей.

  # Find subcommand index in orig[] — для scan на --all/--multiple ПОСЛЕ sub.
  sub_idx=0
  for ((__k=0; __k<n; __k++)); do
    case "${orig[$__k]}" in
      push|fetch|pull) sub_idx=$__k; break ;;
    esac
  done
  unset __k

  # Текущая ветка (пустая строка при detached HEAD; rc≠0 → пустая).
  current_branch="$("$REAL" "${ctx[@]}" "${cfg[@]}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

  # Multi-remote: ТРИГГЕРЫ (замер живьём архитектором, git 2.55):
  #   argv `--all`, argv `--multiple`, конфиг `fetch.all=true`
  # Распространяется на fetch И pull (замер: `git pull --all` при origin+zevil
  # реально тянет ОБА remote, чужой tip оказывается в FETCH_HEAD — клетка г27).
  # `push --all` — refspec-режим «all branches», НЕ мульти (триггерить на нём
  # мульти нельзя — сломает клетки г17/г28: push --all у пуша другая семантика).
  # `--no-all` ОТМЕНЯЕТ `fetch.all=true` (man git-fetch: «overridden by passing
  # --no-all»). `--no-multiple` симметрично (на всякий случай).
  multi_remote=0
  if [ "$sub" = "fetch" ] || [ "$sub" = "pull" ]; then
    __has_all=0; __has_noall=0; __has_multiple=0
    for ((__k=sub_idx+1; __k<n; __k++)); do
      case "${orig[$__k]}" in
        --all) __has_all=1 ;;
        --no-all) __has_noall=1 ;;
        --multiple) __has_multiple=1 ;;
      esac
    done
    if [ "$__has_all" -eq 1 ] || [ "$__has_multiple" -eq 1 ]; then
      multi_remote=1
    elif [ "$__has_noall" -eq 0 ]; then
      # fetch.all=true в КОНФИГЕ (`git config --get --bool fetch.all` →
      # «true» при включённом; rc≠1 при отсутствии ключа — НЕ триггерит).
      __fa="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get --bool fetch.all 2>/dev/null || true)"
      case "$__fa" in
        true|yes|on|1) multi_remote=1 ;;
      esac
    fi
    unset __has_all __has_noall __has_multiple __fa
  fi
  unset __k

  # Список remote-имён для проверки.
  remotes_list=()
  if [ "$multi_remote" -eq 1 ]; then
    # Только настроенные remote (`git remote`). Если команда не сработала
    # (нет remote вовсе — крайний canary) — передаём настоящему git (он сам
    # откажет «No remote configured to allow fetching from»): обёртка не
    # присваивает чужие отказы (И-2, канарейка г7-класса).
    while IFS= read -r __r; do
      [ -n "$__r" ] && remotes_list+=("$__r")
    done < <("$REAL" "${ctx[@]}" "${cfg[@]}" remote 2>/dev/null)
    unset __r
    if [ "${#remotes_list[@]}" -eq 0 ]; then
      exec "$REAL" "${orig[@]}"
    fi
  elif [ -n "$bare_name" ]; then
    # Явный аргумент пользователя или значение --repo: один remote,
    # существующая семантика И-4б (F1R для именованных).
    remotes_list=("$bare_name")
  else
    case "$sub" in
      push)
        # 1) branch.<current>.pushRemote (при наличии ветки)
        if [ -n "$current_branch" ]; then
          __r="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "branch.$current_branch.pushRemote" 2>/dev/null || true)"
          [ -n "$__r" ] && remotes_list=("$__r")
        fi
        # 2) remote.pushDefault
        if [ "${#remotes_list[@]}" -eq 0 ]; then
          __r="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "remote.pushDefault" 2>/dev/null || true)"
          [ -n "$__r" ] && remotes_list=("$__r")
        fi
        # 3) branch.<current>.remote (при наличии ветки)
        if [ "${#remotes_list[@]}" -eq 0 ] && [ -n "$current_branch" ]; then
          __r="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "branch.$current_branch.remote" 2>/dev/null || true)"
          [ -n "$__r" ] && remotes_list=("$__r")
        fi
        # 4) origin (default)
        if [ "${#remotes_list[@]}" -eq 0 ]; then
          remotes_list=("origin")
        fi
        ;;
      fetch|pull)
        # 1) branch.<current>.remote
        if [ -n "$current_branch" ]; then
          __r="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "branch.$current_branch.remote" 2>/dev/null || true)"
          [ -n "$__r" ] && remotes_list=("$__r")
        fi
        # 2) origin (default)
        if [ "${#remotes_list[@]}" -eq 0 ]; then
          remotes_list=("origin")
        fi
        ;;
    esac
  fi
  unset __r 2>/dev/null || true

  # Цикл проверки КАЖДОГО remote в списке. Любая ошибка → отказ всего обмена
  # (fail-closed). Для multi-remote liveness тоже делается здесь (per-remote),
  # а И-7 ниже пропускается — единый `ls-remote <target>` для multi-remote
  # не имеет смысла (нет единого target'а).
  any_bad=0
  first_eff=""
  bad_lines=()   # строки отказа: "<remote>: <reason>"

  for check_remote in "${remotes_list[@]}"; do
    # Зондирование настроенности: `config --get remote.<name>.url` rc≠0 ⇔
    # remote НЕ настроен (ключ отсутствует в любом уровне конфига).
    # Единственный надёжный канал «настроенности»: `remote get-url` может
    # раскрыть insteadOf и вернуть URL при пустом config-ключе (критик 045-Б2).
    # single-remote: rc≠0 → передача настоящему git (канарейка г7-класса).
    # multi-remote: rc≠0 не должно случаться (мы перечислили только
    # настроенные через `git remote`); на всякий случай — canary.
    probe_rc=0
    u_cfg="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "remote.$check_remote.url" 2>/dev/null)" \
      || probe_rc=$?
    if [ "$probe_rc" -ne 0 ]; then
      if [ "$multi_remote" -eq 1 ]; then
        any_bad=1
        bad_lines+=("$(sanitize "$check_remote"): запрос URL завершился неуспешно")
        continue
      fi
      exec "$REAL" "${orig[@]}"
    fi

    # Remote НАСТРОЕН. Снимаем остальные формы цели, ловя rc КАЖДОЙ: `|| true`
    # подменяет rc на 0 и пустой результат — неотличимо от «нет ключа». Этим
    # злоупотребляет проба 127 адверсария 045: rc≠0 на настроенном remote →
    # «пустой origin» → тихая передача в неканон. Теперь rc явный (И-4/проба 127):
    #
    #   config --get remote.<name>.url          (видит -c перекрытия, без insteadOf)
    #   remote get-url <name>                   (видит insteadOf)
    # Для push дополнительно:
    #   config --get remote.<name>.pushurl
    #   remote get-url --push <name>
    # (критик 045-Б2/Б3: ОБЕ формы обязаны проверяться.)
    #
    # <контекст> = сохранённые -C/-c/--git-dir/--work-tree глобальные флаги
    # ОБЯЗАТЕЛЬНО те же, что у исполняемого вызова (И-4: единство разрешения).
    u_get_rc=0
    u_get="$("$REAL" "${ctx[@]}" "${cfg[@]}" remote get-url "$check_remote" 2>/dev/null)" \
      || u_get_rc=$?
    p_cfg=""; p_get=""
    p_cfg_rc=0; p_get_rc=0
    if [ "$sub" = push ]; then
      p_cfg="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "remote.$check_remote.pushurl" 2>/dev/null)" \
        || p_cfg_rc=$?
      p_get="$("$REAL" "${ctx[@]}" "${cfg[@]}" remote get-url --push "$check_remote" 2>/dev/null)" \
        || p_get_rc=$?
    fi

    # fail-closed: запрос на НАСТРОЕННОМ remote (probe_rc=0) — rc≠0.
    # URL-запросы (`remote get-url`) ОБЯЗАНЫ вернуть rc=0; pushurl-запрос
    # `config --get remote.<name>.pushurl` законно rc=1 при незаданном
    # pushurl (pushurl опционален). `remote get-url --push` rc=1 — отказ.
    if [ "$u_get_rc" -ne 0 ] || [ "$p_get_rc" -ne 0 ]; then
      any_bad=1
      bad_lines+=("$(sanitize "$check_remote"): запрос URL завершился неуспешно")
      continue
    fi

    # URL-запросы ОБЯЗАНЫ вернуть непусто (настроенный remote имеет URL);
    # pushurl-запросы могут быть пустыми (pushurl опционален).
    if [ -z "$u_cfg" ] || [ -z "$u_get" ]; then
      any_bad=1
      bad_lines+=("$(sanitize "$check_remote"): URL настроенного remote пуст")
      continue
    fi

    # Каждая НЕПУСТАЯ форма обязана быть ЛИТЕРАЛЬНО канонична (И-5).
    bad=0
    for v in "$u_cfg" "$u_get" "$p_cfg" "$p_get"; do
      [ -z "$v" ] && continue
      if [ "$v" != "$CANON" ]; then bad=1; fi
    done

    # Фактическая цель: для push с заданным pushurl — раскрытый pushurl,
    # иначе раскрытый url. (pushurl «задан» = `config --get pushurl` непуст.)
    if [ "$sub" = push ] && [ -n "$p_cfg" ]; then eff="$p_get"; else eff="$u_get"; fi
    [ -n "$eff" ] || eff="$u_cfg"

    if [ "$bad" -eq 1 ]; then
      any_bad=1
      bad_lines+=("$(sanitize "$check_remote"): URL не канонический: $(sanitize "$eff")")
      continue
    fi

    # Для multi-remote liveness делаем ЗДЕСЬ (per-remote); для single-remote —
    # ниже в И-7, на eff первой (и единственной) записи.
    if [ "$multi_remote" -eq 1 ]; then
      "$REAL" "${ctx[@]}" ls-remote "$eff" HEAD >/dev/null 2>&1
      lrc=$?
      if [ "$lrc" -ne 0 ]; then
        any_bad=1
        bad_lines+=("$(sanitize "$check_remote"): авторитет недоступен (ls-remote rc=$lrc)")
        continue
      fi
    fi

    [ -z "$first_eff" ] && first_eff="$eff"
  done

  if [ "$any_bad" -eq 1 ]; then
    # Multi-remote (или несколько плохих): ВСЕ плохие перечисляются (один
    # отказ на remote — обёртка не прячет «кто именно»). Формат: обёрточный
    # заголовок + ПО ОДНОЙ строке F1R/F2-формата на каждый плохой remote
    # (так что grep -qF по существующим фразам «gitw ОТКАЗ: URL remote
    # <имя> не канонический: » работает без изменений — прецедент
    # архитектуры, клетки г19+).
    if [ "$multi_remote" -eq 1 ] || [ "${#bad_lines[@]}" -gt 1 ]; then
      printf 'gitw ОТКАЗ: многоцелевой обмен отказан, неканонические или недоступные цели:\n' >&2
      for line in "${bad_lines[@]}"; do
        rname="${line%%:*}"
        reason="${line#*: }"
        case "$reason" in
          "авторитет недоступен"*)
            printf '  gitw ОТКАЗ: авторитет недоступен: ls-remote %s rc=%s\n' \
              "$(sanitize "$rname")" "${reason##*rc=}" >&2
            ;;
          "запрос URL завершился неуспешно")
            printf '  gitw ОТКАЗ: запрос URL настроенного remote %s завершился неуспешно\n' \
              "$(sanitize "$rname")" >&2
            ;;
          "URL настроенного remote пуст")
            printf '  gitw ОТКАЗ: URL настроенного remote %s пуст\n' \
              "$(sanitize "$rname")" >&2
            ;;
          "URL не канонический: "*)
            eff="${reason#URL не канонический: }"
            if [ "$rname" = origin ]; then
              printf '  gitw ОТКАЗ: URL origin не канонический: %s\n' \
                "$(sanitize "$eff")" >&2
            else
              printf '  gitw ОТКАЗ: URL remote %s не канонический: %s\n' \
                "$(sanitize "$rname")" "$(sanitize "$eff")" >&2
            fi
            ;;
          *)
            printf '  gitw ОТКАЗ: URL remote %s: %s\n' \
              "$(sanitize "$rname")" "$(sanitize "$reason")" >&2
            ;;
        esac
      done
    else
      # single-remote failure — старая F1/F1R/F2-семантика для grep -F.
      line="${bad_lines[0]}"
      rname="${line%%:*}"
      reason="${line#*: }"
      case "$reason" in
        "авторитет недоступен"*)
          printf 'gitw ОТКАЗ: авторитет недоступен: ls-remote %s rc=%s\n' \
            "$(sanitize "$rname")" "${reason##*rc=}" >&2
          ;;
        "запрос URL завершился неуспешно")
          printf 'gitw ОТКАЗ: запрос URL настроенного remote %s завершился неуспешно\n' \
            "$(sanitize "$rname")" >&2
          ;;
        "URL настроенного remote пуст")
          printf 'gitw ОТКАЗ: URL настроенного remote %s пуст\n' \
            "$(sanitize "$rname")" >&2
          ;;
        "URL не канонический: "*)
          eff="${reason#URL не канонический: }"
          if [ "$rname" = origin ]; then
            printf 'gitw ОТКАЗ: URL origin не канонический: %s\n' \
              "$(sanitize "$eff")" >&2
          else
            printf 'gitw ОТКАЗ: URL remote %s не канонический: %s\n' \
              "$(sanitize "$rname")" "$(sanitize "$eff")" >&2
          fi
          ;;
        *)
          printf 'gitw ОТКАЗ: URL remote %s: %s\n' \
            "$(sanitize "$rname")" "$(sanitize "$reason")" >&2
          ;;
      esac
    fi
    exit 1
  fi

  # Все проверки прошли. target = eff первого (и единственного для single)
  # remote — для downstream И-5/И-7 (single-remote).
  target="$first_eff"
fi

# ── И-5: сверка цели с каноном (для ЛЮБОЙ формы — явный URL или origin) ────
# ЛЮБАЯ цель обмена (явный URL-аргумент ИЛИ сконфигурированный origin)
# обязана быть ЛИТЕРАЛЬНО канонична (И-5). Явный URL — короткая ветка: цель
# одна, проверяется напрямую; origin — многоветвевая ветка с eff-таргетом
# (выше). И-4(a): «первый не-опциональный ... если он URL-подобен — цель = он»,
# и И-5 требует сверку. Живая проба критика 045-Б5: явный неканонический URL
# так же опасен, как подмена origin (модель угроз перечисляет ОБЕ формы явно).
# Для multi-remote target = first_eff первого прошедшего remote — он каноничен
# (проверено выше в И-4в), И-5 здесь no-op.
if [ -n "$target" ] && [ "$target" != "$CANON" ]; then
  printf 'gitw ОТКАЗ: URL origin не канонический: %s\n' "$(sanitize "$target")" >&2
  exit 1
fi

# ── И-7: живость авторитета — fail-closed ──────────────────────────────────
# Цель = фактическая цель обмена из И-4. Сетевой сбой не есть санкция:
# rc≠0 → rc 1 F2.
# Для multi-remote liveness уже проверен per-remote в И-4в — здесь no-op.
if [ "${multi_remote:-0}" -ne 1 ]; then
  "$REAL" "${ctx[@]}" ls-remote "$target" HEAD >/dev/null 2>&1
  lrc=$?
  if [ "$lrc" -ne 0 ]; then
    printf 'gitw ОТКАЗ: авторитет недоступен: ls-remote %s rc=%s\n' "$target" "$lrc" >&2
    exit 1
  fi
fi

# ── И-8: прозрачная передача ─────────────────────────────────────────────────
# Прошедшее суждение → exec "$REAL" "${orig[@]}". argv побайтово тот же,
# код возврата реального git, stdout/stderr не перехватываются, обёртка
# молчит. И-9: GIT_DIR/GIT_WORK_TREE и прочие git-переменные действуют
# на запрос и исполнение ОДИНАКОВО (наследуются exec'у как есть).
exec "$REAL" "${orig[@]}"
