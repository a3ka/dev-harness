#!/usr/bin/env bash
# scripts/gitw — обёртка git-обмена (push/fetch/pull) с pre-exchange гардом
# цели (контракт 045, И-1..И-9). Судит КАЖДУЮ непустую форму цели ДО
# исполнения обмена; несовпадение с каноном = rc 1 F1 с именованной
# фактической целью; недостижимость авторитета = rc 1 F2; неизвестный
# глобальный флаг = rc 1 F3; не-обменные подкоманды и не-git PATH — exec.
#
# Коды возврата:
# 0 — обмен исполнен (или не-обменная подкоманда прозрачно передана через И-8)
# 1 — отказ: F1 URL не канонический, F2 авторитет недоступен, F3 неизвестный флаг
# 2 — NOT_IMPLEMENTED: настоящий git не найден в PATH (И-1, граница-1)
set -uo pipefail

# ── И-1: разрешение настоящего git ──────────────────────────────────────────
# Первый `git` в PATH, чей realpath ≠ realpath самой обёртки. Не найден →
# rc 2 NOT_IMPLEMENTED. Граница-1 (вариант а frontier): суждение на execve.
SELF_REAL="$(readlink -f "$0" 2>/dev/null || /usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
REAL=""
IFS_SAV="$IFS"
IFS=':'
for d in $PATH; do
  IFS="$IFS_SAV"
  [ -z "$d" ] && d="."
  [ -x "$d/git" ] || continue
  cand="$(readlink -f "$d/git" 2>/dev/null || /usr/bin/readlink -f "$d/git" 2>/dev/null || echo "$d/git")"
  if [ "$cand" != "$SELF_REAL" ]; then
    REAL="$d/git"
    break
  fi
done
IFS="$IFS_SAV"
if [ -z "$REAL" ]; then
  printf 'gitw NOT_IMPLEMENTED: настоящий git не найден\n' >&2
  exit 2
fi

# ── И-5: канонический URL — ЕДИНСТВЕННАЯ константа ───────────────────────────
# Ручка GIT_EXCHANGE_GUARD_CANONICAL заменяет её целиком (граница-4: ровно
# одна обходная ручка). Сравнение — ТОЛЬКО буквальное равенство целых строк
# (И-5: норма-класс 037 accept_task_commit).
CANON="${GIT_EXCHANGE_GUARD_CANONICAL:-ssh://git@github.com/a3ka/dev-harness.git}"

# ── И-6: санитизация печати ─────────────────────────────────────────────────
# Каждый байт <0x20 или =0x7F → '?'. Подделка строк отказа переносом строки
# внутри URL невозможна (управляющий байт гасится на печати).
sanitize() {
  printf '%s' "$1" | LC_ALL=C tr '\001-\037\177' '?'
}

# ── И-2: разбор argv, fail-closed ───────────────────────────────────────────
# Ведущие глобальные флаги потребляются по arity; первый не-флаг = подкоманда.
# НЕраспознанный ведущий флаг → rc 1 F3 с именем флага (подкоманда не
# определена надёжно → несудимый обмен запрещён).
orig=( "$@" )
ctx=()
cfg=()
n=${#orig[@]}
i=0
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  case "$a" in
    -C|--git-dir|--work-tree|--namespace|--exec-path)
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2; exit 1; }
      ctx+=("$a" "${orig[$((i+1))]}")
      i=$((i+2))
      ;;
    -c)
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2; exit 1; }
      cfg+=("$a" "${orig[$((i+1))]}")
      i=$((i+2))
      ;;
    --git-dir=*|--work-tree=*|--namespace=*|--exec-path=*)
      ctx+=("$a")
      i=$((i+1))
      ;;
    --bare|--no-pager|--paginate|--no-replace-objects|--literal-pathspecs|--no-optional-locks)
      ctx+=("$a")
      i=$((i+1))
      ;;
    -*)
      # Неизвестный ведущий флаг: arity неизвестна, подкоманда ненадёжна.
      printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2
      exit 1
      ;;
    *)
      sub="$a"
      i=$((i+1))
      break
      ;;
  esac
done

# ── И-3: судимые подкоманды ─────────────────────────────────────────────────
# Ровно push/fetch/pull. Всё прочее — прозрачная передача (И-8).
case "$sub" in
  push|fetch|pull) ;;
  *) exec "$REAL" "${orig[@]}" ;;
esac

# ── И-4a: repository argument — URL / SCP / path / bare-name / --repo= ────
# Git docs (gitrepository-layout / git-push «repository argument»): четыре
# синтаксические формы:
#   URL-like : содержит '://'
#   SCP-like : содержит ':', при этом до ':' нет '/'
#              (т.е. `[user@]host:path` — gitrepository-layout; иначе форма
#              считается path-like с двоеточием в имени)
#   path-like: начинается с /, ./ или ../
#   bare     : всё прочее — потенциальное имя настроенного remote (см. И-4б)
# Имя, не попавшее ни в одну форму, но не настроенное как remote — настоящий
# git сам откажет, обёртка передаёт вызов (канарейка г7-класса, И-2).
#
# РАСШИРЕНИЕ (адверсарий 045-v3 confirm): `git push --repo=<repository>`
# (`git help push`: «equivalent to the <repository> argument. If both are
# specified, the command-line argument takes precedence»). Распознаётся
# ДО generic `-*`-skip — без этого живой обход: `--repo=evil --all` молча
# проглатывался, target оставался пуст, обёртка проверяла канонический
# origin, настоящий git исполнял push в неканонический remote `evil`.
#
# ПРЕЦЕДЕНТ (man git-push): «the command-line argument takes precedence».
# Позиционная цель СИЛЬНЕЕ --repo=: `push --repo=origin <evil-path>` реально
# уходит в <evil-path> (замер арх-разведки 045-2). Реализация БУКВАЛЬНОГО
# приоритета --repo открыла бы НОВЫЙ обход (--repo=origin отмывает злой
# позиционный). Поэтому --repo=* запоминается в repo_value и применяется
# ТОЛЬКО если позиционная цель не найдена; последний --repo=* выигрывает
# (соответствует семантике git при множественных --repo=).
#
# Раздельная форма `--repo <value>` НЕ обрабатывается отдельно: существующий
# `-*`-skip обёртки потребляет `--repo`, а `<value>` естественно попадает
# в arm `*` (default) как bare_name и подвергается И-4б-проверке настроенного
# remote (арх-замер 045-2: текущий gitw уже отказывает F1R для
# `push --repo evil --all`). Добавление отдельного handler для `--repo`
# (arity 2) — лишняя поверхность и потенциальная ловушка «оба токена
# пропустить», которая снимает bare_name-классификацию со `value` и
# восстанавливает обход через дефолтный origin (стаб reposepskip архитектора).
target=""
bare_name=""
repo_value=""
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  case "$a" in
    --repo=*)
      # Равн-форма: запомнить VALUE, НЕ выставлять target/bare_name —
      # позиционная цель должна выиграть (man git-push «command-line
      # argument takes precedence»). Последний --repo=* выигрывает.
      repo_value="${a#--repo=}"
      i=$((i+1))
      ;;
    *://*|/*|../*|./*)
      target="$a"
      i=$((i+1))
      break
      ;;
    *:*)
      # SCP-like: двоеточие ДО первого слэша. ${a%%:*} — префикс до ПЕРВОГО
      # ':'; если в нём нет '/', форма — scp-like (а не path-like `a/b:c`).
      prefix="${a%%:*}"
      case "$prefix" in
        */*) ;; # slash before colon → не scp-like
        *)
          target="$a"
          i=$((i+1))
          break
          ;;
      esac
      ;;
    -*) i=$((i+1)) ;;
    *)
      # Первый не-опциональный bare-аргумент — имя возможного remote.
      bare_name="$a"
      i=$((i+1))
      break
      ;;
  esac
done

# Fallback: если позиционная цель не найдена, использовать --repo=*
# (запомненное выше; если их было несколько — последнее, как и git).
if [ -z "$target" ] && [ -z "$bare_name" ] && [ -n "$repo_value" ]; then
  value="$repo_value"
  case "$value" in
    *://*|/*|../*|./*) target="$value" ;;
    *:*)
      vprefix="${value%%:*}"
      case "$vprefix" in
        */*) bare_name="$value" ;; # slash-before-colon → не scp-like, но тоже bare (path с двоеточием)
        *) target="$value" ;;
      esac
      ;;
    *) bare_name="$value" ;;
  esac
fi

if [ -z "$target" ]; then
  # ── И-4б: цель из настроенного remote (явное имя или дефолтный origin) ──
  # Какой remote проверяем: bare_name (первый bare-аргумент) если задан,
  # иначе origin — поведение по умолчанию для «без positional-цели».
  check_remote="${bare_name:-origin}"

  # Зондирование настроенности: `config --get remote.<name>.url` rc≠0 ⇔
  # remote НЕ настроен (ключ отсутствует в любом уровне конфига).
  # Это — единственный надёжный канал «настроенности»: `remote get-url`
  # может раскрыть insteadOf и вернуть URL при пустом config-ключе (критик
  # 045-Б2). rc≠0 → передача настоящему git (канарейка г7-класса) —
  # независимо от того, явно имя или дефолтный origin (И-2).
  probe_rc=0
  u_cfg="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "remote.$check_remote.url" 2>/dev/null)" \
    || probe_rc=$?
  if [ "$probe_rc" -ne 0 ]; then
    exec "$REAL" "${orig[@]}"
  fi

  # Remote НАСТРОЕН (probe_rc=0). Снимаем остальные формы цели, ловя rc
  # КАЖДОЙ: `|| true` подменяет rc на 0 и пустой результат — неотличимо от
  # «нет ключа». Этим злоупотребляет проба 127 адверсария 045: rc≠0 на
  # настроенном remote → «пустой origin» → тихая передача в неканон.
  # Теперь rc явный (И-4/проба 127):
  #
  #   config --get remote.<name>.url          (видит -c перекрытия, без insteadOf)
  #   remote get-url <name>                   (видит insteadOf)
  # Для push дополнительно:
  #   config --get remote.<name>.pushurl
  #   remote get-url --push <name>
  # (критик 045-Б2/Б3: ОБЕ формы обязаны проверяться.)
  #
  # <контекст> = сохранённые -C/-c/--git-dir/--work-tree глобальные флаги
  # ОБЯЗАТЕЛЬНО те же, что у исполняемого вызова (И-4: единство разрешения).
  # Bash word-splits: индексные массивы в кавычках — каждый элемент
  # отдельный argv (И-4). Сравнения целых строк (И-5) — без glob/regex.
  u_get_rc=0
  u_get="$("$REAL" "${ctx[@]}" "${cfg[@]}" remote get-url "$check_remote" 2>/dev/null)" \
    || u_get_rc=$?
  p_cfg=""; p_get=""
  p_cfg_rc=0; p_get_rc=0
  if [ "$sub" = push ]; then
    p_cfg="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get "remote.$check_remote.pushurl" 2>/dev/null)" \
      || p_cfg_rc=$?
    p_get="$("$REAL" "${ctx[@]}" "${cfg[@]}" remote get-url --push "$check_remote" 2>/dev/null)" \
      || p_get_rc=$?
  fi

  # (3) fail-closed F1: запрос на НАСТРОЕННОМ remote (probe_rc=0) — rc≠0.
  # URL-запросы (`remote get-url`) ОБЯЗАНЫ вернуть rc=0; pushurl-запрос
  # `config --get remote.<name>.pushurl` законно rc=1 при незаданном
  # pushurl (pushurl опционален). `remote get-url --push` rc=1 — отказ.
  if [ "$u_get_rc" -ne 0 ] || [ "$p_get_rc" -ne 0 ]; then
    printf 'gitw ОТКАЗ: запрос URL настроенного remote %s завершился неуспешно\n' \
      "$(sanitize "$check_remote")" >&2
    exit 1
  fi

  # URL-запросы ОБЯЗАНЫ вернуть непусто (настроенный remote имеет URL);
  # pushurl-запросы могут быть пустыми (pushurl опционален, «не задан» — норма).
  if [ -z "$u_cfg" ] || [ -z "$u_get" ]; then
    printf 'gitw ОТКАЗ: URL настроенного remote %s пуст\n' \
      "$(sanitize "$check_remote")" >&2
    exit 1
  fi

  # Каждая НЕПУСТАЯ форма обязана быть ЛИТЕРАЛЬНО канонична (И-5). Любая
  # неканоническая форма → отказ F1.
  bad=0
  for v in "$u_cfg" "$u_get" "$p_cfg" "$p_get"; do
    [ -z "$v" ] && continue
    if [ "$v" != "$CANON" ]; then bad=1; fi
  done

  # Фактическая цель: для push с заданным pushurl — раскрытый pushurl,
  # иначе раскрытый url. (pushurl «задан» = `config --get pushurl` непуст.)
  if [ "$sub" = push ] && [ -n "$p_cfg" ]; then eff="$p_get"; else eff="$u_get"; fi
  [ -n "$eff" ] || eff="$u_cfg"

  if [ "$bad" -eq 1 ]; then
    # Сообщение F1: «URL origin» для origin (дефолтный или именованный —
    # преемственность с существующими клетками г0-г12), «URL remote <name>»
    # для прочих имён (новые клетки г13+ архитектора, явная атрибуция).
    if [ "$check_remote" = origin ]; then
      printf 'gitw ОТКАЗ: URL origin не канонический: %s\n' \
        "$(sanitize "$eff")" >&2
    else
      printf 'gitw ОТКАЗ: URL remote %s не канонический: %s\n' \
        "$(sanitize "$check_remote")" "$(sanitize "$eff")" >&2
    fi
    exit 1
  fi
  target="$eff"
fi

# ── И-5: сверка цели с каноном (для ЛЮБОЙ формы — явный URL или origin) ────
# ЛЮБАЯ цель обмена (явный URL-аргумент ИЛИ сконфигурированный origin)
# обязана быть ЛИТЕРАЛЬНО канонична (И-5). Явный URL — короткая ветка: цель
# одна, проверяется напрямую; origin — многоветвевая ветка с eff-таргетом
# (выше). И-4(a): «первый не-опциональный ... если он URL-подобен — цель = он»,
# и И-5 требует сверку. Живая проба критика 045-Б5: явный неканонический URL
# так же опасен, как подмена origin (модель угроз перечисляет ОБЕ формы явно).
if [ -n "$target" ] && [ "$target" != "$CANON" ]; then
  printf 'gitw ОТКАЗ: URL origin не канонический: %s\n' "$(sanitize "$target")" >&2
  exit 1
fi

# ── И-7: живость авторитета — fail-closed ──────────────────────────────────
# Цель = фактическая цель обмена из И-4. Сетевой сбой не есть санкция:
# rc≠0 → rc 1 F2.
"$REAL" "${ctx[@]}" ls-remote "$target" HEAD >/dev/null 2>&1
lrc=$?
if [ "$lrc" -ne 0 ]; then
  printf 'gitw ОТКАЗ: авторитет недоступен: ls-remote %s rc=%s\n' "$target" "$lrc" >&2
  exit 1
fi

# ── И-8: прозрачная передача ─────────────────────────────────────────────────
# Прошедшее суждение → exec "$REAL" "${orig[@]}". argv побайтово тот же,
# код возврата реального git, stdout/stderr не перехватываются, обёртка
# молчит. И-9: GIT_DIR/GIT_WORK_TREE и прочие git-переменные действуют
# на запрос и исполнение ОДИНАКОВО (наследуются exec'у как есть).
exec "$REAL" "${orig[@]}"