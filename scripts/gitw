#!/usr/bin/env bash
# scripts/gitw — обёртка git-обмена (push/fetch/pull) с pre-exchange гардом
# цели (контракт 045, И-1..И-9). Судит КАЖДУЮ непустую форму цели ДО
# исполнения обмена; несовпадение с каноном = rc 1 F1 с именованной
# фактической целью; недостижимость авторитета = rc 1 F2; неизвестный
# глобальный флаг = rc 1 F3; не-обменные подкоманды и не-git PATH — exec.
#
# Коды возврата:
# 0 — обмен исполнен (или не-обменная подкоманда прозрачно передана через И-8)
# 1 — отказ: F1 URL не канонический, F2 авторитет недоступен, F3 неизвестный флаг
# 2 — NOT_IMPLEMENTED: настоящий git не найден в PATH (И-1, граница-1)
set -uo pipefail

# ── И-1: разрешение настоящего git ──────────────────────────────────────────
# Первый `git` в PATH, чей realpath ≠ realpath самой обёртки. Не найден →
# rc 2 NOT_IMPLEMENTED. Граница-1 (вариант а frontier): суждение на execve.
SELF_REAL="$(readlink -f "$0" 2>/dev/null || /usr/bin/readlink -f "$0" 2>/dev/null || echo "$0")"
REAL=""
IFS_SAV="$IFS"
IFS=':'
for d in $PATH; do
  IFS="$IFS_SAV"
  [ -z "$d" ] && d="."
  [ -x "$d/git" ] || continue
  cand="$(readlink -f "$d/git" 2>/dev/null || /usr/bin/readlink -f "$d/git" 2>/dev/null || echo "$d/git")"
  if [ "$cand" != "$SELF_REAL" ]; then
    REAL="$d/git"
    break
  fi
done
IFS="$IFS_SAV"
if [ -z "$REAL" ]; then
  printf 'gitw NOT_IMPLEMENTED: настоящий git не найден\n' >&2
  exit 2
fi

# ── И-5: канонический URL — ЕДИНСТВЕННАЯ константа ───────────────────────────
# Ручка GIT_EXCHANGE_GUARD_CANONICAL заменяет её целиком (граница-4: ровно
# одна обходная ручка). Сравнение — ТОЛЬКО буквальное равенство целых строк
# (И-5: норма-класс 037 accept_task_commit).
CANON="${GIT_EXCHANGE_GUARD_CANONICAL:-ssh://git@github.com/a3ka/dev-harness.git}"

# ── И-6: санитизация печати ─────────────────────────────────────────────────
# Каждый байт <0x20 или =0x7F → '?'. Подделка строк отказа переносом строки
# внутри URL невозможна (управляющий байт гасится на печати).
sanitize() {
  printf '%s' "$1" | LC_ALL=C tr '\001-\037\177' '?'
}

# ── И-2: разбор argv, fail-closed ───────────────────────────────────────────
# Ведущие глобальные флаги потребляются по arity; первый не-флаг = подкоманда.
# НЕраспознанный ведущий флаг → rc 1 F3 с именем флага (подкоманда не
# определена надёжно → несудимый обмен запрещён).
orig=( "$@" )
ctx=()
cfg=()
n=${#orig[@]}
i=0
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  case "$a" in
    -C|--git-dir|--work-tree|--namespace|--exec-path)
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2; exit 1; }
      ctx+=("$a" "${orig[$((i+1))]}")
      i=$((i+2))
      ;;
    -c)
      [ "$((i+1))" -lt "$n" ] || { printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2; exit 1; }
      cfg+=("$a" "${orig[$((i+1))]}")
      i=$((i+2))
      ;;
    --git-dir=*|--work-tree=*|--namespace=*|--exec-path=*)
      ctx+=("$a")
      i=$((i+1))
      ;;
    --bare|--no-pager|--paginate|--no-replace-objects|--literal-pathspecs|--no-optional-locks)
      ctx+=("$a")
      i=$((i+1))
      ;;
    -*)
      # Неизвестный ведущий флаг: arity неизвестна, подкоманда ненадёжна.
      printf 'gitw ОТКАЗ: неизвестный глобальный флаг: %s\n' "$a" >&2
      exit 1
      ;;
    *)
      sub="$a"
      i=$((i+1))
      break
      ;;
  esac
done

# ── И-3: судимые подкоманды ─────────────────────────────────────────────────
# Ровно push/fetch/pull. Всё прочее — прозрачная передача (И-8).
case "$sub" in
  push|fetch|pull) ;;
  *) exec "$REAL" "${orig[@]}" ;;
esac

# ── И-4a: явный URL-аргумент ────────────────────────────────────────────────
# Первый не-опциональный аргумент после подкоманды, если он URL-подобен
# (содержит :// или начинается с /, ./, ../) — цель = он.
target=""
while [ "$i" -lt "$n" ]; do
  a="${orig[$i]}"
  case "$a" in
    *://*|/*|../*|./*)
      target="$a"
      i=$((i+1))
      break
      ;;
    -*) i=$((i+1)) ;;
    *) break ;;
  esac
done

if [ -z "$target" ]; then
  # ── И-4б: цель из сконфигурированного origin ─────────────────────────────
  # Сверка КАЖДОЙ непустой формы цели, ВСЕ литерально каноничны:
  #   config --get remote.origin.url           (видит -c перекрытия)
  #   remote get-url origin                    (видит insteadOf-переписывание)
  # Для PUSH дополнительно:
  #   config --get remote.origin.pushurl
  #   remote get-url --push origin
  # Фактическая цель push = pushurl если задан, иначе url (критик 045-Б3).
  # <контекст> = сохранённые -C/-c/--git-dir/--work-tree глобальные флаги
  # ОБЯЗАТЕЛЬНО те же, что у исполняемого вызова (И-4: единство разрешения).
  # Реальный git читает конфиг С учётом insteadOf для `remote get-url`, но
  # НЕ для `config --get` — потому ОБЕ формы обязаны проверяться (критик
  # 045-Б2: живой обход).
  #
  # КРИТИЧНО: bash word-splits переменные по `$IFS` при `$@`-расширении
  # без кавычек. Здесь массивы `ctx`/`cfg` — индексированные; при
  # `"${ctx[@]}"` (в кавычках) каждый элемент — отдельный argv, без
  # join/split. Сравнения целых строк (И-5) — без glob/regex.
  u_cfg="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get remote.origin.url 2>/dev/null || true)"
  u_get="$("$REAL" "${ctx[@]}" "${cfg[@]}" remote get-url origin 2>/dev/null || true)"
  p_cfg=""
  p_get=""
  if [ "$sub" = push ]; then
    p_cfg="$("$REAL" "${ctx[@]}" "${cfg[@]}" config --get remote.origin.pushurl 2>/dev/null || true)"
    p_get="$("$REAL" "${ctx[@]}" "${cfg[@]}" remote get-url --push origin 2>/dev/null || true)"
  fi

  # Нет ключа конфига и нет get-url → нет origin → передача: git откажется
  # сам, обёртка чужие отказы не присваивает (канарейка г7).
  if [ -z "$u_cfg$u_get$p_cfg$p_get" ]; then
    exec "$REAL" "${orig[@]}"
  fi

  # Каждая НЕПУСТАЯ форма обязана быть литерально канонична. Любая
  # неканоническая форма → отказ И-6.
  bad=0
  for v in "$u_cfg" "$u_get" "$p_cfg" "$p_get"; do
    [ -z "$v" ] && continue
    if [ "$v" != "$CANON" ]; then bad=1; fi
  done

  # Фактическая цель: для push с заданным pushurl — раскрытый pushurl,
  # иначе раскрытый url. (pushurl "задан" = `config --get pushurl` непуст.)
  if [ -n "$p_cfg" ]; then eff="$p_get"; else eff="$u_get"; fi
  [ -n "$eff" ] || eff="$u_cfg"

  if [ "$bad" -eq 1 ]; then
    printf 'gitw ОТКАЗ: URL origin не канонический: %s\n' "$(sanitize "$eff")" >&2
    exit 1
  fi
  target="$eff"
fi

# ── И-5: сверка цели с каноном (для ЛЮБОЙ формы — явный URL или origin) ────
# ЛЮБАЯ цель обмена (явный URL-аргумент ИЛИ сконфигурированный origin)
# обязана быть ЛИТЕРАЛЬНО канонична (И-5). Явный URL — короткая ветка: цель
# одна, проверяется напрямую; origin — многоветвевая ветка с eff-таргетом
# (выше). И-4(a): «первый не-опциональный ... если он URL-подобен — цель = он»,
# и И-5 требует сверку. Живая проба критика 045-Б5: явный неканонический URL
# так же опасен, как подмена origin (модель угроз перечисляет ОБЕ формы явно).
if [ -n "$target" ] && [ "$target" != "$CANON" ]; then
  printf 'gitw ОТКАЗ: URL origin не канонический: %s\n' "$(sanitize "$target")" >&2
  exit 1
fi

# ── И-7: живость авторитета — fail-closed ──────────────────────────────────
# Цель = фактическая цель обмена из И-4. Сетевой сбой не есть санкция:
# rc≠0 → rc 1 F2.
"$REAL" "${ctx[@]}" ls-remote "$target" HEAD >/dev/null 2>&1
lrc=$?
if [ "$lrc" -ne 0 ]; then
  printf 'gitw ОТКАЗ: авторитет недоступен: ls-remote %s rc=%s\n' "$target" "$lrc" >&2
  exit 1
fi

# ── И-8: прозрачная передача ─────────────────────────────────────────────────
# Прошедшее суждение → exec "$REAL" "${orig[@]}". argv побайтово тот же,
# код возврата реального git, stdout/stderr не перехватываются, обёртка
# молчит. И-9: GIT_DIR/GIT_WORK_TREE и прочие git-переменные действуют
# на запрос и исполнение ОДИНАКОВО (наследуются exec'у как есть).
exec "$REAL" "${orig[@]}"