# Окружение системы-разработчика.
#
# ── ИСПРАВЛЕНИЕ ложного утверждения ─────────────────────────────────────────────────────
# Первая редакция этого файла заявляла: «ключей провайдеров здесь НЕТ и быть не должно: их
# держит прокси учёта». Это ОКАЗАЛОСЬ НЕВЕРНО, и проверено:
#   * omp отказывается работать с провайдером без его ключа: «No API key found for minimax»,
#     и поля `apiKey` в `.omp/models.yml` ему для этого НЕ достаточно;
#   * запущенный прокси пропускает ключ вызывающего наверх, а не подставляет свой: с
#     ключом-заглушкой MiniMax ответил 401.
# Значит ключ нужен здесь. Утверждение исправлено, а не оставлено «почти верным».
#
# Как это выяснилось: мой прогон «через прокси» проходил, потому что ключ был в МОЁМ
# окружении — он пришёл из `.env` фабрики через обёртку мастерской. У владельца того же
# окружения нет, и тот же запуск падал. Проверка в `env -i` показала разницу.
#
# ЧТО ПРАВИЛЬНО и записано в ROADMAP.md: прокси должен подставлять ключ провайдера сам, тогда
# здесь хватит заглушки. Пока это не так, ключ лежит в двух местах — и это остаточный риск,
# а не решение.

# Адрес прокси учёта. Прокси поднимает проект.
METERING_PROXY_URL=http://127.0.0.1:8787

# Токен прокси. Значение ТО ЖЕ, что у проекта, поднимающего прокси. Пустое значение — не
# «почти заданное»: лаунчер отказывает при запуске, иначе падение придёт на первом вызове с
# причиной, похожей на отсутствие подписки.
METERING_PROXY_TOKEN=

# Ключ провайдера. Нужен, пока прокси не подставляет свой (см. выше).
MINIMAX_API_KEY=
