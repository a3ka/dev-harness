#!/usr/bin/env bash
# Барьер add-A (контракт 016, срез 1) — pre-commit вызывает судью staged-множества.
#
# Это ЧАСТЬ механизма (контракт 016 Q6), а не сам гейт. Гейт — `scripts/check_staged.sh`;
# этот файл только гарантирует, что коммит не случится без проверки. Обходы (`--no-verify`,
# коммит до появления этого файла, неустановленный core.hooksPath) — когнитивный остаток,
# названный прямо в контракте. Не жёсткий гейт: маски — удобство, несущая проверка —
# путь-против-зоны.
#
# КОНТРАКТ 084 §И-11 (пачка А): до `exec check_staged.sh` вызывается `check_plan.sh --pre-commit`
# при существующем `$ROOT/registry/plan.tsv`; без файла — прежнее поведение. Группа (7) —
# только если HANDOFF.md есть в `git diff --cached --name-only` (Р10): теги общие для всех worktree,
# а HANDOFF — файл ветки; полная проверка — CI.
#
# ВЫЗОВ. Аргумент pre-commit по контракту git — путь к репозиторию. Передаём его судье, чтобы
# тот не выводил пользователя из текущего каталога, и выходим с тем же кодом, что вернул судья:
# хук обязан отказать коммиту на отказе судьи, иначе защита не работает.
#
# Ловушка bash: `if ! cmd; then exit $?` теряет код (`!` инвертирует rc, и $? после `!` уже
# инвертированный). Используем явный `if cmd; then :; else exit; fi`.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
  printf 'pre-commit: не удалось определить корень репозитория\n' >&2
  exit 1
fi
if [ -f "$ROOT/registry/plan.tsv" ]; then
  if bash "$ROOT/scripts/check_plan.sh" --root "$ROOT" --pre-commit; then
    :
  else
    rc=$?
    exit "$rc"
  fi
fi
exec bash "$ROOT/scripts/check_staged.sh" "$ROOT"