#!/usr/bin/env bash
# ХУК pre-merge-commit (контракт 086, Н-119, И-3): запрет sync-merge ДО создания
# merge-коммита. Срабатывает, когда пользователь запускает `git merge` в репозитории
# с активным core.hooksPath=.githooks. Без хука merge создаётся в обход гейта accept/land,
# и нарушение (б) «sync-merge» ловится только при приёмке — задержка в часы (Н-119).
#
# СУБЪЕКТ ХУКА — «правило (б) sync-merge» (Frontier 4): merge M синхронный ⟺
# у M есть родители P ≠ Q, где P — предок main/origin/main и P не предок Q.
# Хук НЕ ЗАПУСКАЕТ правила (а) и (в) — это забота точек accept и land (где есть
# доступ к замороженным тегам и полной истории). Хук видит текущий merge и
# решает, можно ли его создавать.
#
# ТЕКУЩАЯ ВЕТКА main — пропуск (направление ленда; сама land_agent.sh вызывает
# гейт сведения ДО merge, и гейт уже всё проверил). Иная ветка — проверка.
#
# ГОЛОВЫ ИЗ GIT_REFLOG_ACTION (замер 1 контракта 086: во время pre-merge-commit
# MERGE_HEAD ещё не записан; вливаемые головы — имена из `GIT_REFLOG_ACTION`
# формы `merge <имя>…`). Каждое имя резолвится в коммит `rev-parse --verify
# <имя>^{commit}`. Если форма строки не парсится — отказ (та же причина, по
# которой барьер должен видеть предмет, а не угадывать; заявленная форма
# GIT_REFLOG_ACTION = ровно `merge <головы через пробелы>`). Решение — по
# предкам коммитов, не по тексту имён (И-8 нормы 041: замкнутые алфавиты,
# побайтовое сравнение).
#
# ГРАММАТИКА ОТКАЗА (И-4 контракта 086, единый источник — гейт сведения):
#   Строка отказа начинается `ОТКАЗ 086 (pre-merge-commit): `, несёт ярлык
#   `правило (б) sync-merge` со своим выходом. Контекст — полный 40-hex sha
#   merge M (И-4: «(б) … полный 40-hex sha merge (окно) либо родителей (хук)»).
#   Выход: «пересобери ветку без merge main». Ярлыка несработавшего правила
#   в выводе нет.
#
# КОДЫ ВОЗВРАТА: 0 — merge можно создавать, 1 — именованный отказ,
# 2 — нечем проверить (нет git / не репозиторий / не HEAD).
set -uo pipefail

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_TEMPLATE_DIR GIT_CEILING_DIRECTORIES
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

LABEL_B='правило (б) sync-merge'
VYHOD_B='выход: пересобери ветку без merge main'
OTKAZ_PREFIX='ОТКАЗ 086 (pre-merge-commit): '

# Точка вызова: SELF_DIR — каталог скриптов, чтобы звать `gejt_svedenija.sh`
# (единый источник, контракт 034). В githooks/ нет подкаталога scripts/, но
# стандартное размещение — `.githooks/pre-merge-commit` рядом с `scripts/`.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$SELF_DIR/scripts/lib_zones.sh" 2>/dev/null || true

command -v git >/dev/null 2>&1 || { printf 'NOT_IMPLEMENTED: нет git\n' >&2; exit 2; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'NOT_IMPLEMENTED: не удалось определить корень\n' >&2; exit 2; }
[ -d "$ROOT" ] || { printf 'NOT_IMPLEMENTED: корень не каталог\n' >&2; exit 2; }
git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 \
  || { printf 'NOT_IMPLEMENTED: %s не репозиторий git\n' "$ROOT" >&2; exit 2; }
git -C "$ROOT" rev-parse --verify HEAD >/dev/null 2>&1 \
  || { printf 'NOT_IMPLEMENTED: в %s нет ни одного коммита\n' "$ROOT" >&2; exit 2; }

# Текущая ветка. main — пропуск (направление ленда; сам ленд зовёт гейт
# сведения, и (б)/(в) уже проверены).
CUR_BRANCH="$(git -C "$ROOT" symbolic-ref -q --short HEAD 2>/dev/null || true)"
if [ "$CUR_BRANCH" = "main" ]; then
  exit 0
fi

# Головы из GIT_REFLOG_ACTION. Форма — `merge <имя…>` (замер 1 контракта 086).
# Иная форма — отказ (барьер не должен угадывать предмет).
REFLOG="${GIT_REFLOG_ACTION:-}"
case "$REFLOG" in
  'merge '*)
    # Снять префикс `merge `, оставить остаток.
    HEADS_LINE="${REFLOG#merge }"
    ;;
  *)
    # Пусто или иная форма — пропускаем (pre-merge-commit по факту merge).
    # Это может быть `merge --ff-only`, `merge --abort`, и т.п. Нас интересует
    # только реальный merge; если форма неясна, не отказываем.
    exit 0
    ;;
esac

# Пустая строка после `merge ` — синтаксически не парсится; пропускаем.
[ -n "$HEADS_LINE" ] || exit 0

# Текущая голова (HEAD) — кандидат в первый родитель merge.
HEAD_SHA="$(git -C "$ROOT" rev-parse HEAD)"

# Предикат sync: merge M синхронный ⟺ у M есть родители P ≠ Q, где P — предок
# main/origin/main и P не предок Q (Frontier 4, Б-4 ревьюера). Проверяем ВСЕ
# родители merge — main может быть ЛЮБЫМ из них (pre-merge-commit срабатывает,
# когда HEAD уже на main-sha в detached режиме: `git checkout main-sha && git
# merge wip` создаёт merge, где main — ПЕРВЫЙ родитель). Хедеры видим через
# GIT_REFLOG_ACTION формы `merge <имя…>` — каждое имя резолвим в коммит; плюс
# сам HEAD как один из родителей (HEAD может быть main-sha, а вливаемые головы —
# нет). Без полного множества родителей merge хук пропускает обратный порядок
# (та же логика, что в gejt_svedenija.sh sync_violation() для F2 — общий
# предикат, иначе расхождение между гейтом и хуком; не дублируем код —
# повторяем логику дословно).
sync=0
sync_head=""
sync_p=""
sync_q=""
# Все кандидаты-родители merge: вливаемые головы + сам HEAD.
PARENTS_CANDIDATES="$HEADS_LINE"
# Добавить HEAD как «голову», только если имя в $HEADS_LINE его не покрывает:
# на detached HEAD merge `git merge wip` записывает `merge wip` в GIT_REFLOG_ACTION,
# и HEAD отдельно не нужен; на ветке HEAD тоже не обязателен как голова merge.
# Чтобы охватить и detached-HEAD-на-main случай (Б-4), проверяем множество
# {H ∈ $HEADS_LINE} ∪ {HEAD_SHA} — иначе main-первый-родитель остаётся невидим.
if [ "$HEAD_SHA" != "$(git -C "$ROOT" rev-parse --verify --quiet "${HEADS_LINE%% *} ^{commit}" 2>/dev/null)" ]; then
  PARENTS_CANDIDATES="$PARENTS_CANDIDATES HEAD"
fi

# Проверяем КАЖДУЮ пару (P, Q) разных родителей: P — предок main/origin/main,
# P не предок Q. Именаторы P из $PARENTS_CANDIDATES, именаторы Q — все
# $PARENTS_CANDIDATES (плюс HEAD). Двойной цикл по множеству родителей.
# Сводим имена → коммиты один раз.
declare -A _COMMIT_OF=()
declare -A _RESOLVED=()
for h in $PARENTS_CANDIDATES; do
  if [ "$h" = "HEAD" ]; then
    c="$HEAD_SHA"
  else
    c="$(git -C "$ROOT" rev-parse --verify --quiet "${h}^{commit}" 2>/dev/null)" || continue
  fi
  [ -n "$c" ] || continue
  _COMMIT_OF["$h"]="$c"
done
for h in $PARENTS_CANDIDATES; do
  [ -n "${_COMMIT_OF[$h]:-}" ] || continue
  P="${_COMMIT_OF[$h]}"
  # P — предок main/origin/main?
  if ! git -C "$ROOT" merge-base --is-ancestor "$P" main 2>/dev/null \
     && ! git -C "$ROOT" merge-base --is-ancestor "$P" origin/main 2>/dev/null; then
    continue
  fi
  # P — предок Q (любого другого родителя)? Если ДА — sync не сработает (P — общий предок).
  ancestor_of_some=0
  for h2 in $PARENTS_CANDIDATES; do
    [ "$h" = "$h2" ] && continue
    [ -n "${_COMMIT_OF[$h2]:-}" ] || continue
    Q="${_COMMIT_OF[$h2]}"
    if [ "$P" = "$Q" ]; then continue; fi
    if git -C "$ROOT" merge-base --is-ancestor "$P" "$Q" 2>/dev/null; then
      ancestor_of_some=1
      break
    fi
  done
  if [ "$ancestor_of_some" -eq 0 ]; then
    sync=1
    sync_head="$h"
    sync_p="$P"
    # Печатаем ПЕРВЫЙ Q как контекст (для детерминированности отказа; И-4
    # «(б) … либо родителей (хук)» принимает обоих родителей в любом порядке).
    for h2 in $PARENTS_CANDIDATES; do
      [ "$h" = "$h2" ] && continue
      [ -n "${_COMMIT_OF[$h2]:-}" ] || continue
      sync_q="${_COMMIT_OF[$h2]}"
      break
    done
    break
  fi
done

if [ "$sync" -eq 1 ]; then
  # Контекст — оба родителя (И-4 «(б) … либо родителей (хук)»). Это полнее,
  # чем sha ещё-не-созданного merge, и привязано к конкретным объектам.
  printf '%s%s; sha %s; sha %s; %s\n' \
    "$OTKAZ_PREFIX" "$LABEL_B" "$sync_p" "$sync_q" "$VYHOD_B" >&2
  exit 1
fi

exit 0
