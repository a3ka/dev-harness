{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "tmp"],
  "$defs": {
    "path": {"type": "string", "minLength": 2, "pattern": "^/[^\\u0000\\r\\n]*$(?![\\s\\S])"},
    "days": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}
  },
  "properties": {
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "retention_days", "repos"],
      "properties": {
        "root": {"$ref": "#/$defs/path"},
        "retention_days": {"$ref": "#/$defs/days"},
        "repos": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}}
      }
    },
    "tmp": {
      "type": "object", "additionalProperties": false,
      "required": ["retention_days", "runners", "worker_names", "proc_root", "cgroup_root", "systemctl", "lock_path"],
      "properties": {
        "retention_days": {"$ref": "#/$defs/days"},
        "runners": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["root", "unit"],
            "properties": {"root": {"$ref": "#/$defs/path"},
              "unit": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]*\\.service$(?![\\s\\S])"}}}},
        "worker_names": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/name"}},
        "proc_root": {"$ref": "#/$defs/path"},
        "cgroup_root": {"$ref": "#/$defs/path"},
        "lock_path": {"$ref": "#/$defs/path"},
        "systemctl": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$(?![\\s\\S])"}
      }
    }
  }
}
