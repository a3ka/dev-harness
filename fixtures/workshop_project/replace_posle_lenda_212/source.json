 "kejsy": {
  "r01-chestnyj-replace": "ленд состоялся, тег опубликован, строка = id-тег — REPLACE проходит прямым коммитом сквозь живую дверь (rc 0)",
  "r02-teg-ne-na-origin": "frozen-тег жив локально, НЕ запушен на origin (self-freeze) — именованный отказ, дерево не мутировано",
  "r03-zamorozka-ne-predok-main": "frozen-тег опубликован, но коммит заморозки НЕ предок origin/main (ленд не состоялся) — отказ",
  "r04-staraja-stroka-chuzhaja": "строка N указывает на посторонний sha (ни id-тег, ни frozen/<vmax-1>) — отказ старой стороны",
  "r05-povtornyj-replace": "строка N уже указывает на tag-object frozen/<vmax> — повторный REPLACE отказ",
  "r06-grjaznoe-derevo": "рабочее дерево грязное (untracked) — отказ до любых обменов, дерево не мутировано",
  "r07-ne-main": "HEAD на wip-ветке — отказ «не main» до любых обменов",
  "r08-main-rashoditsja": "локальный main позади origin/main — отказ расхождения до записи",
  "r09-dver-otkljuchena": "core.hooksPath ведёт в каталог без pre-commit — именованный отказ конфиг-дизарма ДО записи",
  "r10-stroki-net": "строки N нет в манифесте — REPLACE нечего менять",
  "r11-frozen-ljogkij": "локальный frozen-тег лёгкий (не аннотированный) — отказ",
  "r12-dve-stroki": "в манифесте две строки N — отказ неоднозначности",
  "r13-drejf-frozen": "локальный frozen-тег перетегирован (sha ≠ origin) — отказ переминта заморозки",
  "r14-avtoritet-nedostupen": "origin недоступен (ls-remote rc 128) — fail-closed «авторитет недоступен», НЕ «тег не выдан»",
  "r15-vysokaja-versija": "живы frozen/N/1 и /2, строка = id-тег — REPLACE ставит tag-object ВЫСШЕЙ заморозки (/2)",
  "r16-dogon-vtoroj-versii": "строка = tag-object frozen/N/1, жива /2 — догон: старая сторона = frozen/<vmax-1>",
  "r17-chuzhij-hvost-bez-lf": "чужая грамматическая последняя строка манифеста БЕЗ завершающего LF — честный REPLACE проходит прямым коммитом, чужие байты и край файла сохранены (Б-2)",
  "r18-stroka-n-poslednjaja-bez-lf": "строка N — последняя и без завершающего LF — REPLACE проходит, новая строка тоже без LF, прочие байты целы (Б-2)",
  "r19-manifest-nul": "в манифесте NUL-байт — именованный отказ до записи, полный stderr без предупреждений оболочки, состояние не меняется (Б-3)",
  "r20-manifest-crlf": "строка N заканчивается CRLF — отказ грамматики манифеста с номером первой неконформной строки (Б-3)",
  "r21-manifest-lishnie-polja": "в строке N лишние поля после sha — отказ грамматики манифеста (Б-3)",
  "r22-manifest-pustaja-stroka": "в манифесте пустая строка — отказ грамматики манифеста с номером строки (Б-3)",
  "r23-peremint-tot-zhe-kommit": "опубликованный annotated тег переминчен на тот же commit: tag-object различны, peeled commits равны — отказ переминта",
  "r24-otkaz-hooka-otkat": "исполняемый pre-commit печатает DENIED и отказывает: rc 1, HEAD, байты реестра и чистый индекс восстановлены",
  "r25-atomarnaja-zamena": "честный REPLACE через временный файл и mv: идентичность реестра меняется, открытый старый файл сохраняет исходные байты",
  "r26-peremint-vtoroj-versii": "живы /1 и опубликованная /2; remint /2 на тот же commit — именованный отказ переминта выбранного vmax=2",
  "r27-mv-na-toj-zhe-fs": "честный REPLACE: источник фактически исполняемого mv реестра на той же ФС, что каталог реестра (без EXDEV-копирования)",
  "r28-tmpdir-cwd-drugaja-fs": "TMPDIR и cwd на другой ФС: источник mv реестра остаётся на ФС реестра; нет доступной другой ФС — rc 2, не пропуск"
 },
