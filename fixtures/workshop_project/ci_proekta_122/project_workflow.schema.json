{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subject", "project"],
  "properties": {
    "schemaVersion": {"const": 1},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "path", "blob", "origin"],
      "properties": {
        "root": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]+$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*[.]md$"},
        "blob": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "origin": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$"}
      }
    },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "projectId", "repoId", "canonicalRemote"],
      "properties": {
        "root": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]+$"},
        "projectId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"},
        "repoId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"},
        "canonicalRemote": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000\\r\\n]+$"}
      }
    }
  }
}
