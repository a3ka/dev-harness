{"$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false, "required": ["version", "exceptions"], "properties": {"version": {"const": 1}, "exceptions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["blob", "call", "map", "reason", "author", "date", "owner_ref"], "properties": {"blob": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-fA-F]{40}$"}, "call": {"type": "string", "pattern": "^[1-9][0-9]*$", "not": {"pattern": "[^0-9]"}}, "map": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"type": "string", "pattern": "^\u041a-(0[1-9]|1[0-7]): [^\\r\\n]+$"}}, "reason": {"type": "string", "minLength": 1}, "author": {"type": "string", "minLength": 1}, "date": {"type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "owner_ref": {"type": "string", "minLength": 6, "maxLength": 6, "pattern": "^R-[0-9]{4}$"}}}}}}