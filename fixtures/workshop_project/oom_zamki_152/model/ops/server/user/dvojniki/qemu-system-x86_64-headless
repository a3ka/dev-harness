#!/usr/bin/env bash
# файл-имя двойника: адресуется ЯДРО по своему реальному пути (симлинк на
# двойника резолвится к имени запрета, а не к псевдониму) — само имя
# запрета передаёт первым аргументом, $0 здесь ничего не значит.
Z="$(realpath "$0")"
exec "$(dirname "$Z")/_jadro.sh" "$(basename "$Z")" "$@"
