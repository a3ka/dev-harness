#!/usr/bin/env bash
# Форма stand-in пробы композиции v2 (контракт 118; усиление батареи после
# freeze по арбитражу 117↔118 РЕШЕНИЕ п.1–2 и слову владельца 2026-10-24;
# ось expires_at — 118 v2 по B1 Adv118b круга 2 «истёкшая валидная Session
# → W1A» и варианту «Б-мини» консультанта n118-sessija-demo: демо-сессия
# 995 получает далёкую дату, допуск — единый fail-closed expiry-контроль).
# Продукт держит mobile/src/bootstrap/__tests__/kompozicija.stand-in.sh
# БАЙТ-В-БАЙТ равным этому носителю: пин sha256 зашит в proverka
# proiskhozdenija (KOMPOZICIJA_FORMA_SHA256), подмена таблицей ожиданий
# или заглушкой даёт именованный отказ KOMPOZICIJA_FORMA.
# Семантика (арбитраж п.2 + путь W0 = вариант B + срок 118 v2):
#   admission решает ПОВЕРХНОСТЬ после demo: W1A → erstinformation при
#     ЛЮБОМ gate (null/stale/current); не-W1A (W0) — путь B:
#     auth.begin → f03-02-code (Г0 корня F03 сохраняется);
#   gate решает ПЕРЕХОД: continue → start ТОЛЬКО при W1A ∧ current;
#     при null/stale continue НЕ переводит, Start отсутствует;
#   срок сессии (expires_at) — единый fail-closed контроль допуска на
#     корне И на маршруте /start: действителен только срок СТРОГО в
#     будущем момента чтения; пустая/неразборчивая/прошлая дата и «ровно
#     сейчас» — сессия недействительна → путь B и запрет Start даже при
#     admission=W1A ∧ gate=current (B1 Adv118b круга 2);
#   начальный кадр 'first-run' при ЛЮБОМ entry и любом порте;
#   Start — только continue (смена темы автостарта не даёт).
# Источники: admission/gate/срок — ТОЛЬКО порт сессии (аргументы
# вызывающего); entry.onboarding ('complete' и пр.), entry.gate и
# посторонние поля порта (authenticated и т.п.) источником допуска НЕ
# являются. Порт читается В МОМЕНТ действия ($6/$8 — текущий срез после
# rerender, срок — тем же срезом), не кэшируется на монтаже ($1/$7).
# Исполнение настоящей композиции (jest-проба из
# mobile/src/bootstrap/__tests__/, admission из внешнего источника —
# сессии/проверяющего) судит продуктовый CI; эта форма — её видимый шов.
# Вне алфавита любого поля — rc 3 (именованный отказ, не дефолт-вердикт).
set -u
admission="${1:?admission=W0|W1A}"
gate="${2:?gate=null|stale|current}"
entry="${3:-net}"
sobytie="${4:?sobytie}"
extra="${5:-net}"
admission_tek="${6:-$admission}"
expires="${7-2099-12-31T00:00:00Z}"
expires_tek="${8-$expires}"
case "$admission" in W0|W1A) ;; *) exit 3 ;; esac
case "$gate" in null|stale|current) ;; *) exit 3 ;; esac
case "$entry" in net|unknown|incomplete|complete) ;; *) exit 3 ;; esac
case "$extra" in net|postoronnee-pole|entry-gate-current) ;; *) exit 3 ;; esac
case "$sobytie" in montazh|demo|demo-continue|tema|rerender-demo|rerender-continue|remount|start-marshrut) ;; *) exit 3 ;; esac

SEJCHAS="$(date -u +%s)"

srok_dejstvitelen() {
  # fail-closed (B1 Adv118b): срок СТРОГО в будущем момента чтения порта;
  # пустое/неразборчивое значение и «ровно сейчас» (литерал now — текущий
  # срез часов читающего) действительным сроком не признаются. Часы
  # читаются ОДИН раз на вызов формы — «ровно сейчас» детерминирован.
  [ -n "$1" ] || return 1
  case "$1" in
    now) sekund="$SEJCHAS" ;;
    *) sekund="$(date -u -d "$1" +%s)" || return 1 ;;
  esac
  case "$sekund" in ''|*[!0-9-]*) return 1 ;; esac
  [ "$sekund" -gt "$SEJCHAS" ]
}

poverhnost() {
  if [ "$admission_tek" = "W1A" ] && srok_dejstvitelen "$expires_tek"; then
    echo erstinformation
  else
    echo f03-02-code
  fi
}

start_reshenie() {
  if [ "$admission_tek" = "W1A" ] && [ "$gate" = "current" ] && srok_dejstvitelen "$expires_tek"; then
    echo start_dopushchen
  else
    echo start_ne_dopushchen
  fi
}

case "$sobytie" in
  montazh) echo first-run ;;
  demo) poverhnost ;;
  demo-continue)
    if [ "$(poverhnost)" = erstinformation ]; then
      start_reshenie
    else
      echo start_ne_dopushchen
    fi ;;
  start-marshrut) start_reshenie ;;
  tema) poverhnost ;;
  rerender-demo) poverhnost ;;
  rerender-continue) start_reshenie ;;
  remount) echo first-run ;;
  *) exit 3 ;;
esac
